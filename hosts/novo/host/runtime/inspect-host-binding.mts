// Read-only compiler and executing-binary verification; no SQL or network execution.
import { readFileSync, realpathSync } from 'node:fs';
import { execFileSync } from 'node:child_process';
import { createHash } from 'node:crypto';
import { dirname, join, resolve } from 'node:path';
import { fileURLToPath } from 'node:url';
import { verifyNodeRuntimeProfile } from '../../../../producer/scripts/verify-node-runtime-profile.ts';
import { createBuildIdentity } from '../../../../producer/src/readiness/buildIdentity.ts';
import { compileCloudPilotPublicationContextSql, CLOUD_PILOT_SOURCE } from '../../../../producer/src/db/cloudPilotSqlControl.ts';
import { assertPortableRefreshPlan } from '../../../../producer/scripts/p0-cloud-portable-source-pilot.ts';
import { getSourceQualityPolicy, SOURCE_QUALITY_POLICY_ID } from '../../../../producer/src/crawler/sourceQualityAdmission.ts';
import { requiresBGradeTraversalCertificate } from '../../../../producer/src/crawler/traversalCertificate.ts';
import { deriveCurrentStagedScheduleExpectation } from '../../../../producer/src/crawler/stagedScheduleAuthority.ts';
const host=resolve(dirname(fileURLToPath(import.meta.url)),'..');
const cfg=JSON.parse(readFileSync(join(host,'host-config.json'),'utf8'));
if(cfg.root!==host||process.execPath!==cfg.node||realpathSync(process.execPath)!==cfg.node)throw Error('HOST_NODE22_BINDING');
const nodeRuntime=await verifyNodeRuntimeProfile();
if(CLOUD_PILOT_SOURCE.id!==cfg.sourceId||CLOUD_PILOT_SOURCE.sourceConfigSha256!==cfg.sourceConfigSha256)throw Error('HOST_SOURCE_CONFIG_MISMATCH');
const control=JSON.parse(readFileSync(join(host,'control-base.json'),'utf8'));
const binding=JSON.parse(readFileSync(join(host,'activation.json'),'utf8'));
if(binding.status!=='REGISTERED_VERIFIED'||!control.candidate||!Number.isSafeInteger(control.candidate.version)||control.candidate.version!==51||control.candidate.id!=='dot-cloud-delta-proxy-28402a29-20261007')throw Error('CANDIDATE_NOT_REGISTERED');
const commit=execFileSync('git',['rev-parse','HEAD'],{cwd:cfg.repo,encoding:'utf8',env:{...process.env,GIT_OPTIONAL_LOCKS:'0'}}).trim();
if(execFileSync('git',['status','--porcelain'],{cwd:cfg.repo,encoding:'utf8',env:{...process.env,GIT_OPTIONAL_LOCKS:'0'}}).trim())throw Error('HOST_DIRTY_PRODUCER');
const build=createBuildIdentity(cfg.repo,commit);
if(JSON.stringify(build)!==JSON.stringify(control.build)||JSON.stringify(control.build)!==JSON.stringify(binding.build)||JSON.stringify(control.candidate)!==JSON.stringify(binding.candidate))throw Error('HOST_BUILD_IDENTITY_MISMATCH');
const sourcePlan=deriveCurrentStagedScheduleExpectation(control.build).plans.find(plan=>plan.source.id===cfg.sourceId);
if(!sourcePlan||getSourceQualityPolicy(sourcePlan)!==SOURCE_QUALITY_POLICY_ID||requiresBGradeTraversalCertificate(sourcePlan))throw Error('HOST_ORIGINAL_PORTABLE_ROUTE_REQUIRED');
assertPortableRefreshPlan(sourcePlan);
const context=compileCloudPilotPublicationContextSql(control,'PLAN_BOUND_SOURCE_QUALITY_V1');
if(readFileSync(join(host,'context-read.sql'),'utf8')!==context)throw Error('HOST_CONTEXT_COMPILER_BINDING_MISMATCH');
const contextReadSha256=createHash('sha256').update(context).digest('hex');
if(binding.contextReadSha256!==contextReadSha256)throw Error('HOST_CONTEXT_COMPILER_BINDING_MISMATCH');
console.log(JSON.stringify({build,candidate:control.candidate,nodeRuntime,contextReadSha256,noNetwork:true,noDatabase:true}));
