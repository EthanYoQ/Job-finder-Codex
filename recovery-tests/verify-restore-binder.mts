// Narrow offline restoration proof. Invented owner/readback; no DB, HTTP, launch or real state access.
import assert from 'node:assert/strict';
import {readFileSync,writeFileSync,mkdtempSync,existsSync,readdirSync,lstatSync} from 'node:fs';
import {createHash} from 'node:crypto';
import {execFileSync} from 'node:child_process';
import {join,resolve} from 'node:path';
import {deriveCurrentStagedScheduleExpectation} from '../producer/src/crawler/stagedScheduleAuthority.ts';
import {compileCloudPilotPublicationContextSql} from '../producer/src/db/cloudPilotSqlControl.ts';

const base=resolve(import.meta.dirname,'..'),host=join(base,'hosts/gilead/host');
const cfg=JSON.parse(readFileSync(join(host,'host-config.template.json'),'utf8'));
const template=JSON.parse(readFileSync(join(host,'owner-binding-input.template.json'),'utf8'));
const output=mkdtempSync(join(import.meta.dirname,'restore-binder-run-'));
const sha=(s:string|Buffer)=>createHash('sha256').update(s).digest('hex');
const protectedFiles=['runtime/load-host-state.js','runtime/prepare-owner-binding.mts','runtime/complete-reviewed-source-readback.js'];
const before=Object.fromEntries(protectedFiles.map(p=>[p,sha(readFileSync(join(host,p)))]));
assert.equal(before['runtime/complete-reviewed-source-readback.js'],'3eb561c5c3dc1aa4a8897d83ac9bd857830bee33e1a39702b173e63934793527');
const results:any[]=[];const pass=(name:string)=>results.push({name,passed:true});
const restoreScript=join(base,'recovery-templates/restore-unbound-host.py');
const restore=(destination:string)=>JSON.parse(execFileSync('python3',[restoreScript,destination],{encoding:'utf8',stdio:['pipe','pipe','pipe'],env:{...process.env,PYTHONDONTWRITEBYTECODE:'1'}}));
const restored=restore(join(output,'restored-runtime'));
assert.equal(restored.activation,'UNREGISTERED_NOT_ACTIVATED');
assert.equal(restored.candidate,null);assert.equal(restored.databaseIdentity,null);
assert.equal(restored.existingHostModified,false);assert.equal(restored.launchAuthorized,false);
assert.equal(restored.physicalProducer,cfg.repo);
const candidateMarker='const expectedCandidate=null; // OWNER_CANDIDATE_BINDING';
const databaseMarker='const expectedDatabaseIdentity=null; // OWNER_DATABASE_BINDING';
const loaderPath=join(restored.host,'runtime/load-host-state.js');
const starterPath=join(restored.outputRoot,'hosts/gilead/supervision/start-monitor-gilead-next-combined.js');
const loader=readFileSync(loaderPath,'utf8'),starter=readFileSync(starterPath,'utf8');
assert.equal(sha(loader),'e12fdec0403c58c1d6f7c014bd4d3c3b0d34bdb4c443c901611a5443eafa71b4');
assert.equal(sha(starter),'89487bf2378f4fdca66096d645557872ba67cce2b78f7bdbb189210594ce939b');
assert.equal(loader.split(candidateMarker).length,2);assert.equal(loader.split(databaseMarker).length,2);
assert.equal(starter.split(candidateMarker).length,2);
pass('Safe restore uses exact original unbound templates and creates an isolated unregistered host');
const candidate={id:'synthetic-only-restored-gilead-host',goalId:'jobfinder-portable-required-40',version:52};
const databaseIdentity={migrationVersion:'20261006172300_job_projection_delta_contract',schemaHash:'d'.repeat(64),dbSnapshotHash:'e'.repeat(64)};
const owner={...template,candidate,databaseIdentity};
const e=deriveCurrentStagedScheduleExpectation(owner.build);
const candidateRow={...candidate,...databaseIdentity,commitSha:e.commitSha,rosterHash:e.rosterSha256,sourcePlanHash:e.sourcePlanSha256,sourceConfigHash:e.sourceConfigSha256,adapterBundleHash:e.adapterBundleSha256,sourceTreeHash:e.sourceTreeSha256,runtimeTreeHash:e.runtimeTreeSha256,minimumStableCompanyCount:e.minimumStableCompanyCount,oracleVersion:'staged-official-source-v1',status:'BUILDING'};
const ownerPath=join(output,'synthetic-owner.json'),readbackPath=join(output,'synthetic-readback.json');
writeFileSync(ownerPath,JSON.stringify(owner)+'\n');writeFileSync(readbackPath,JSON.stringify({candidateRow})+'\n');
const binder=(destination:string)=>execFileSync(cfg.node,['--import',join(cfg.repo,'node_modules/tsx/dist/loader.mjs'),restored.binder,ownerPath,readbackPath,destination],{cwd:cfg.repo,encoding:'utf8',stdio:['pipe','pipe','pipe'],env:{...process.env,JOBFINDER_CLOUD_SOURCE_ID:cfg.sourceId,TSX_DISABLE_CACHE:'1',NODE_DISABLE_COMPILE_CACHE:'1',GIT_OPTIONAL_LOCKS:'0'}});
const preparedPath=join(output,'prepared'),prepared=JSON.parse(binder(preparedPath));
assert.equal(prepared.classification,'OWNER_BINDING_PREPARED_NOT_ACTIVATED');
assert.equal(prepared.registrationPerformed,false);assert.equal(prepared.sqlExecuted,false);assert.equal(prepared.activationWritten,false);
assert.equal(existsSync(join(preparedPath,'host/activation.json')),false);
assert.equal(JSON.parse(readFileSync(join(preparedPath,'host/activation.prepared.json'),'utf8')).status,'PREPARED_NOT_ACTIVATED');
assert.equal(readFileSync(join(preparedPath,'host/runtime/load-host-state.js'),'utf8'),loader.replace(candidateMarker,'const expectedCandidate='+JSON.stringify(candidate)+'; // OWNER_CANDIDATE_BINDING').replace(databaseMarker,'const expectedDatabaseIdentity='+JSON.stringify(databaseIdentity)+'; // OWNER_DATABASE_BINDING'));
assert.equal(readFileSync(join(preparedPath,'supervision/start-monitor-gilead-next-combined.js'),'utf8'),starter.replace(candidateMarker,'const expectedCandidate='+JSON.stringify(candidate)+'; // OWNER_CANDIDATE_BINDING'));
for(const item of prepared.files){const bytes=readFileSync(join(preparedPath,item.path));assert.equal(bytes.length,item.bytes);assert.equal(sha(bytes),item.sha256);}
pass('Actual restored binder verifies real frozen runtime and emits exact synthetic PREPARED bytes and hashes');
const context=compileCloudPilotPublicationContextSql({projectId:cfg.project,build:owner.build,candidate,databaseIdentity},'PLAN_BOUND_SOURCE_QUALITY_V1');
assert.equal(readFileSync(join(preparedPath,'host/context-read.sql'),'utf8'),context);
assert.equal(prepared.contextReadSha256,sha(context));
pass('Restored binder preserves exact compiler context bytes without extra LF or SQL execution');
writeFileSync(loaderPath,readFileSync(join(host,'runtime/load-host-state.js')));
const rejected=join(output,'rejected-bound-loader');
assert.throws(()=>binder(rejected),(error:any)=>String(error.stderr).includes('HOST_CANDIDATE_MARKER'));
assert.equal(existsSync(rejected),false);
writeFileSync(loaderPath,loader);
pass('Restoring the bound loader instead of its null template reproduces marker rejection before output');
assert.throws(()=>restore(restored.outputRoot),(error:any)=>String(error.stderr).includes('RESTORE_REQUIRES_NEW_DIRECTORY'));
assert.throws(()=>restore(join(base,'hosts/gilead/host')),(error:any)=>String(error.stderr).includes('RESTORE_REQUIRES_NEW_DIRECTORY'));
pass('Restore refuses an existing destination and the installed host');
const completion=readFileSync(join(restored.host,'runtime/complete-reviewed-source-readback.js'),'utf8');
assert.equal(sha(completion),before['runtime/complete-reviewed-source-readback.js']);
assert.equal(completion.match(/PUBLISHER-ACTIVE-STATE\.json/g)?.length,1);
assert(completion.includes('const statePath="/workspace/scratch/5e9614251709/jb-incremental-proxy-runtime-20261007T0057Z/PUBLISHER-ACTIVE-STATE.json";'));
function assertNoState(path:string){for(const item of readdirSync(path,{withFileTypes:true})){assert.notEqual(item.name,'PUBLISHER-ACTIVE-STATE.json');const p=join(path,item.name);if(item.isDirectory()&&!lstatSync(p).isSymbolicLink())assertNoState(p);}}
assertNoState(output);
pass('Restoration retains the successful 3eb completion and never creates a second publisher state');
for(const p of protectedFiles)assert.equal(sha(readFileSync(join(host,p))),before[p]);
assert.equal(execFileSync('git',['status','--porcelain'],{cwd:cfg.repo,encoding:'utf8'}),'');
pass('Installed loader, binder, completion and frozen producer remain unchanged');
const report={classification:'SYNTHETIC_RESTORE_BINDER_PROOF',passed:results.length,syntheticOnly:true,noDatabase:true,noExternalHttp:true,noLaunch:true,full118Rerun:false,owner51Rerun:false,output,results};
writeFileSync(join(output,'RESTORE_BINDER_RESULTS.json'),JSON.stringify(report,null,2)+'\n');
writeFileSync(join(import.meta.dirname,'RESTORE_BINDER_RESULTS.json'),JSON.stringify(report,null,2)+'\n');
console.log(JSON.stringify({passed:results.length,report:join(output,'RESTORE_BINDER_RESULTS.json')}));
