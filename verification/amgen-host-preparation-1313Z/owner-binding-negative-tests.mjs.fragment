
for(const kind of ['old-build','old-version','old-id'])test('new owner rejects '+kind+' before SQL',async()=>{const f=await fixture(),key=f.ns+'registeredCandidateBinding',binding=structuredClone(f.state.get(key));if(kind==='old-build')binding.build.commitSha='28402a299bb04cbf5873da66c2fe8ca76827c0d1';if(kind==='old-version')binding.candidate.version=51;if(kind==='old-id')binding.candidate.id='dot-cloud-delta-proxy-28402a29-20261007';f.state.set(key,binding);await assert.rejects(f.owner(f.input),/OWNER_REVIEW_BINDING/);assert.equal(f.publishCalls,0);assert.equal(f.pollCalls,0);});
