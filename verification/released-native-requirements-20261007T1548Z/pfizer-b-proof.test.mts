import test from 'node:test';
import assert from 'node:assert/strict';
import {mkdtempSync,writeFileSync,readFileSync,symlinkSync} from 'node:fs';
import {join,resolve} from 'node:path';
import {spawnSync} from 'node:child_process';
import {makePfizerFixture,makeSyntheticRequest,rehashTerminal,sha} from './pfizer-b-proof.fixture.mts';
import {verifyPfizerBProof,reviewPfizerBRequest} from '../../hosts/pfizer/host/runtime/verify-pfizer-b-proof.mts';
import {verifyIndependentValidationInput} from '../../hosts/pfizer/host/runtime/verify-independent-validation.mts';
import {replayPfizerWorkdayTraversal} from '../../producer/src/crawler/pfizerWorkdayTraversal.ts';
const P=import.meta.dirname,R=resolve(P,'../..'),H=join(R,'hosts/pfizer/host'),cfg=JSON.parse(readFileSync(join(H,'host-config.json'),'utf8'));
const f=await makePfizerFixture(),bytes=Buffer.from(JSON.stringify(f.validation));
test('native Pfizer mock main HTTP and independent DOM produce real B with raw=22 included=21 India=1',()=>{const proof=verifyPfizerBProof(f.terminal,f.validation,f.now);assert.equal(proof.grade,'B');assert.equal(proof.rawCount,22);assert.equal(proof.includedMainlandCount,21);assert.equal(proof.auditedIndiaExcludedCount,1);assert.equal(replayPfizerWorkdayTraversal(f.plan,f.result.fetchEvidence!,f.result.jobs,f.now),true);});
test('original validation bytes remain unchanged after input review',()=>{const before=bytes.toString();assert.equal(verifyIndependentValidationInput(bytes,sha(bytes),f.now).status,'VALIDATED_CURRENT_RUN');assert.equal(bytes.toString(),before);});
test('current DOM one-hour boundary is rejected despite seven-day expiry',()=>assert.throws(()=>verifyIndependentValidationInput(bytes,sha(bytes),new Date(Date.parse(f.validation.observedAt)+3600000)),/EXPIRED/));
test('future DOM detail is rejected',()=>assert.throws(()=>verifyIndependentValidationInput(bytes,sha(bytes),new Date(Date.parse(f.validation.observedAt)+1000)),/INVALID|ORIGINAL_TIMES/));
test('wrong validation byte hash is rejected',()=>assert.throws(()=>verifyIndependentValidationInput(bytes,'0'.repeat(64),f.now),/HASH/));
for(const field of ['sourceId','sourceConfigSha256','retrievalPath','observedAt'])test('independent '+field+' cannot be changed',()=>{const v=structuredClone(f.validation);if(field==='observedAt')v.observedAt=new Date(Date.parse(v.observedAt)+60000).toISOString();else (v as any)[field]='wrong';const b=Buffer.from(JSON.stringify(v));assert.throws(()=>verifyIndependentValidationInput(b,sha(b),f.now));});
for(const change of ['A-certificate','reused','wrong-count','missing-current','wrong-source','wrong-raw-set','wrong-excluded-set','loss-count'])test('proof rejects '+change,()=>{const t=structuredClone(f.terminal),c=t.completenessCertificate.legacyCertificate;if(change==='A-certificate')c.schemaVersion='a-grade-official-total-v2';if(change==='reused')c.validationPolicy.execution='REUSED';if(change==='wrong-count')t.dedupeOutputCount++;if(change==='missing-current')t.completenessCertificate.members.pop();if(change==='wrong-source')t.sourceId='source-servier-china-social';if(change==='wrong-raw-set')c.mainTraversal.canonicalRawMatchKeySetSha256='0'.repeat(64);if(change==='wrong-excluded-set')c.mainTraversal.canonicalExcludedMatchKeySetSha256='0'.repeat(64);if(change==='loss-count')t.validationDiscardCount++;rehashTerminal(t);assert.throws(()=>verifyPfizerBProof(t,f.validation,f.now));});
test('main source original 30-minute publication boundary rejected',()=>{const now=new Date(Date.parse(f.terminal.startedAt)+30*60000);assert.throws(()=>verifyPfizerBProof(f.terminal,f.validation,now),/EXPIRED/);});
test('request exact bytes, batch, and expiry are bound',()=>{const req=makeSyntheticRequest(f.terminal,new Date(f.now.getTime()+60000).toISOString()),boot={schemaVersion:1,batchId:f.terminal.batchId,independentValidation:{path:'/synthetic-only/independent.json',sha256:sha(bytes)}};assert.equal(reviewPfizerBRequest(req,boot,bytes,f.now).bProof.grade,'B');assert.throws(()=>reviewPfizerBRequest(req,boot,Buffer.from('{}'),f.now),/HASH/);assert.throws(()=>reviewPfizerBRequest(req,{...boot,batchId:'wrong'},bytes,f.now),/BATCH/);const expired=makeSyntheticRequest(f.terminal,f.now.toISOString());assert.throws(()=>reviewPfizerBRequest(expired,boot,bytes,f.now),/EXPIRY/);});
test('actual readonly input CLI rejects relative and symlink paths and accepts original fresh synthetic bytes',async()=>{const x=await makePfizerFixture({now:new Date()}),dir=mkdtempSync(join(P,'synthetic-input-')),path=join(dir,'validation.json'),data=Buffer.from(JSON.stringify(x.validation));writeFileSync(path,data);symlinkSync(path,join(dir,'linked.json'));for(const [p,ok] of [[path,true],[join(dir,'linked.json'),false],['relative.json',false]] as const){const out=spawnSync(cfg.node,['--require',join(P,'offline.cjs'),'--import',join(cfg.repo,'node_modules/tsx/dist/loader.mjs'),join(H,'runtime/verify-independent-validation.mts'),p,sha(data)],{encoding:'utf8',env:{...process.env,TSX_DISABLE_CACHE:'1',NODE_DISABLE_COMPILE_CACHE:'1'}});assert.equal(out.status===0,ok,out.stderr);}assert.equal(readFileSync(path).toString(),data.toString());});
