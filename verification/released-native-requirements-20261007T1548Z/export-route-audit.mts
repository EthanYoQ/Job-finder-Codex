import assert from 'node:assert/strict';
import {readFileSync,realpathSync} from 'node:fs';
import {createHash} from 'node:crypto';
import {execFileSync} from 'node:child_process';
import {join,resolve} from 'node:path';
import {pathToFileURL} from 'node:url';
const args=process.argv.slice(2);
assert.equal(args.length,4,'--producer <fixed-checkout> --manifest-sha256 <frozen-sha>');
assert.equal(args[0],'--producer');assert.equal(args[2],'--manifest-sha256');
const repo=realpathSync(args[1]),P=import.meta.dirname,R=resolve(P,'../..');
assert.equal(repo,'/workspace/scratch/5e9614251709/jb-incremental-proxy-runtime-20261007T0057Z/producer');
const digest=(b:Buffer)=>createHash('sha256').update(b).digest('hex');
const manifestBytes=readFileSync(join(P,'restore-manifest.json'));
assert.match(args[3],/^[a-f0-9]{64}$/);assert.equal(digest(manifestBytes),args[3]);
const manifest=JSON.parse(manifestBytes.toString('utf8'));
const raw=readFileSync(join(P,'static-inputs.json'));assert.equal(digest(raw),manifest.staticInputsSha256);
const d=JSON.parse(raw.toString('utf8'));
assert.deepEqual(Object.keys(d).sort(),['schemaVersion','producerCommit','sourceId','route','sourceConfigSha256','sourceConfig','currentSourcePlan','implementationSha256'].sort());
assert.equal(d.schemaVersion,1);assert.equal(d.producerCommit,'28402a299bb04cbf5873da66c2fe8ca76827c0d1');
assert.equal(execFileSync('git',['-C',repo,'rev-parse','HEAD'],{encoding:'utf8'}).trim(),d.producerCommit);
for(const [path,hash] of Object.entries(d.implementationSha256)){
 assert(!path.startsWith('/')&&!path.includes('..')&&!path.includes('\\'));
 assert.equal(digest(readFileSync(join(repo,path))),hash,'IMPLEMENTATION_BYTES:'+path);
}
const load=(p:string)=>import(pathToFileURL(join(repo,p)).href);
const {candidateCompanies}=await load('src/data/companyRegistry.ts');
const {buildStagedSourceCrawlPlans,sourcePlanConfigSha256}=await load('src/crawler/sourcePlan.ts');
const {requiresAGradeOfficialTotalCertificate}=await load('src/crawler/completenessCertificate.ts');
const {requiresBGradeTraversalCertificate}=await load('src/crawler/traversalCertificate.ts');
const plans=buildStagedSourceCrawlPlans(candidateCompanies),matching=plans.filter((p:any)=>p.source.id===d.sourceId);
assert.equal(matching.length,1);const plan=matching[0];
assert.deepEqual(plan,d.currentSourcePlan,'FULL_CURRENT_PLAN');
assert.equal(sourcePlanConfigSha256(plan),d.sourceConfigSha256);
assert.deepEqual(Object.keys(d.sourceConfig).sort(),['id','companyId','kind','atsKind','status','officialEntryUrl','officialChainEvidenceUrl'].sort());
for(const [k,v] of Object.entries(d.sourceConfig))assert.deepEqual(plan.source[k],v);
const route=requiresAGradeOfficialTotalCertificate(plan)?'TRUE_A':requiresBGradeTraversalCertificate(plan)?'TRUE_B':'UNSUPPORTED';
assert.equal(route,d.route);assert.equal(route,'TRUE_B');
const reference=JSON.parse(readFileSync(join(R,'hosts/pfizer/host/source-config-reference.json'),'utf8'));
assert.deepEqual(reference,{sourceId:d.sourceId,route:d.route,sourceConfigSha256:d.sourceConfigSha256,source:d.sourceConfig});
console.log(JSON.stringify({sourceId:d.sourceId,route,sourceConfigSha256:d.sourceConfigSha256,fullPlanEqual:true,implementationHashes:Object.keys(d.implementationSha256).length,network:false,database:false,runtimeExecuted:false}));
