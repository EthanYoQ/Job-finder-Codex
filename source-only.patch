+const CITY_PROVINCES = new Map<string, string>([
+  ...[...PROVINCES].filter(([, code]) => ["11", "12", "31", "50"].includes(code)),
+  ...PREFECTURES.flatMap(([code, names]) => names.split(" ").map(name => [name, code] as [string, string]))
+]);
