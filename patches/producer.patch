+-- Compact canonical JSON for the shared TypeScript JSON wire contract. Objects
+-- use UTF-8 byte order; arrays retain order. jsonb expands JSON exponent numbers,
+-- so normalize their exact decimal wire values back to JSON.stringify notation.
+CREATE FUNCTION public.job_projection_canonical_json(value jsonb) RETURNS text
+LANGUAGE plpgsql IMMUTABLE STRICT SECURITY INVOKER
+SET search_path = pg_catalog, public
+AS $canonical$
+DECLARE
+    result text;
+    number_text text;
+    unsigned_text text;
+    digits text;
+    integer_part text;
+    fraction_part text;
+    sign_text text;
+    exponent_value integer;
+BEGIN
+    CASE jsonb_typeof(value)
+    WHEN 'object' THEN
+        SELECT '{' || coalesce(string_agg(to_json(e.key)::text || ':' ||
+            public.job_projection_canonical_json(e.value), ',' ORDER BY convert_to(e.key, 'UTF8')), '') || '}'
+        INTO result FROM jsonb_each(value) e;
+    WHEN 'array' THEN
+        SELECT '[' || coalesce(string_agg(public.job_projection_canonical_json(e.value), ',' ORDER BY e.position), '') || ']'
+        INTO result FROM jsonb_array_elements(value) WITH ORDINALITY e(value, position);
+    WHEN 'number' THEN
+        IF value::text::numeric = 0 THEN RETURN '0'; END IF;
+        number_text := value::text;
+        IF position('.' IN number_text) > 0 THEN number_text := rtrim(rtrim(number_text, '0'), '.'); END IF;
+        sign_text := CASE WHEN left(number_text, 1) = '-' THEN '-' ELSE '' END;
+        unsigned_text := ltrim(number_text, '-');
+        integer_part := split_part(unsigned_text, '.', 1);
+        fraction_part := split_part(unsigned_text, '.', 2);
+        IF integer_part <> '0' THEN
+            exponent_value := length(integer_part) - 1;
+            digits := rtrim(integer_part || fraction_part, '0');
+        ELSE
+            exponent_value := -(length(fraction_part) - length(ltrim(fraction_part, '0'))) - 1;
+            digits := rtrim(ltrim(fraction_part, '0'), '0');
+        END IF;
+        IF exponent_value >= 21 OR exponent_value < -6 THEN
+            result := sign_text || left(digits, 1) || CASE WHEN length(digits) > 1 THEN '.' || substr(digits, 2) ELSE '' END ||
+                'e' || CASE WHEN exponent_value >= 0 THEN '+' ELSE '' END || exponent_value::text;
+        ELSE result := number_text;
+        END IF;
+    ELSE result := value::text;
+    END CASE;
+    RETURN result;
+END;
+$canonical$;
