+        IF NEW."completenessState" <> 'FAILED' OR NEW."failureCode" IS NULL OR btrim(NEW."failureCode") = '' OR
+           NEW."failureReason" IS NULL OR btrim(NEW."failureReason") = '' OR
+           (NEW."transportState" IN ('FAILED', 'BLOCKED', 'SKIPPED') AND NEW."adapterState" <> 'SKIPPED') OR
+           (NEW."transportState" = 'SUCCEEDED' AND NEW."adapterState" NOT IN ('FAILED', 'BLOCKED', 'SKIPPED')) OR
+           NEW."transportState" NOT IN ('SUCCEEDED', 'FAILED', 'BLOCKED', 'SKIPPED') THEN
+            RAISE EXCEPTION 'NOT_ATTEMPTED source result terminal state is inconsistent';
+        END IF;
+    ELSIF NEW."atomicCommitState" IN ('FAILED', 'ROLLED_BACK') THEN
+        IF NEW."transportState" <> 'SUCCEEDED' OR NEW."adapterState" <> 'SUCCEEDED' OR
+           NEW."completenessState" <> 'FAILED' OR NEW."failureCode" IS NULL OR btrim(NEW."failureCode") = '' OR
+           NEW."failureReason" IS NULL OR btrim(NEW."failureReason") = '' THEN
+            RAISE EXCEPTION 'FAILED or ROLLED_BACK source result terminal state is inconsistent';
+        END IF;
+    ELSE
+        RAISE EXCEPTION 'Unsupported CrawlBatchSourceResult terminal state';
+    END IF;
+    -- BEGIN JOB DELTA RECEIPT RESTORE
+    IF delta_receipt IS NOT NULL THEN
+        NEW."completenessCertificate" := delta_receipt;
+        NEW."completenessCertificateSha256" := delta_receipt_sha256;
+    END IF;
+    -- END JOB DELTA RECEIPT RESTORE
+    RETURN NEW;
+END;
+$function$;
+
+-- One event per newly published wrapper result. Recheck its final transaction
+-- state after all later statements, not historical receipts on future Job writes.
+-- Incremental callers must force only the three original SQL48 constraint
+-- triggers IMMEDIATE; this new event must remain deferred until actual COMMIT.
+CREATE FUNCTION public.validate_job_delta_commit_projection() RETURNS trigger
+LANGUAGE plpgsql SECURITY INVOKER
+SET search_path = pg_catalog, public
+AS $delta_commit$
+DECLARE
+    committed_result public."CrawlBatchSourceResult"%ROWTYPE;
+    committed_job public."Job"%ROWTYPE;
+    committed_member jsonb;
+    expected_binding jsonb;
+BEGIN
+    expected_binding := jsonb_build_object('releaseCandidateId',NEW."releaseCandidateId",'batchId',NEW."batchId",'sourceId',NEW."sourceId",'sourceResultId',NEW."id");
+    SELECT r.* INTO committed_result FROM public."CrawlBatchSourceResult" r WHERE
+        r."id" = NEW."id" AND r."releaseCandidateId" = NEW."releaseCandidateId" AND
+        r."batchId" = NEW."batchId" AND r."sourceId" = NEW."sourceId";
+    IF NOT FOUND THEN RAISE EXCEPTION 'JOB_DELTA_COMMIT_RESULT_MISSING'; END IF;
+    IF NOT (
+        committed_result."atomicCommitState" = 'COMMITTED' AND committed_result."completenessState" = 'VERIFIED' AND
+        committed_result."finishedAt" = NEW."finishedAt" AND
+        committed_result."completenessCertificate" = NEW."completenessCertificate" AND
+        committed_result."completenessCertificateSha256" = NEW."completenessCertificateSha256" AND
+        committed_result."completenessCertificate"->>'schemaVersion' = 'job-projection-delta-receipt-v1' AND
+        committed_result."completenessCertificate"->'binding' = expected_binding AND
+        committed_result."completenessCertificateSha256" = encode(sha256(convert_to(
+            public.job_projection_canonical_json(committed_result."completenessCertificate"),'UTF8')),'hex')
+    ) IS TRUE THEN RAISE EXCEPTION 'JOB_DELTA_COMMIT_RECEIPT_MISMATCH'; END IF;
+    PERFORM public.job_delta_effective_legacy_certificate(committed_result."completenessCertificate",
+        committed_result."completenessCertificateSha256",expected_binding,committed_result."finishedAt");
+    FOR committed_member IN SELECT m.value FROM jsonb_array_elements(committed_result."completenessCertificate"->'members') m
+        WHERE m.value->>'setKind' = 'VISIBLE' LOOP
+        IF NOT (
+            committed_member->>'releaseCandidateId' = NEW."releaseCandidateId" AND committed_member->>'batchId' = NEW."batchId" AND
+            committed_member->>'sourceId' = NEW."sourceId" AND committed_member->>'sourceResultId' = NEW."id"
+        ) IS TRUE THEN RAISE EXCEPTION 'JOB_DELTA_COMMIT_MEMBER_TUPLE_MISMATCH'; END IF;
+        -- Lock exactly the manifest Job while checking its final projection, so
+        -- a concurrent writer cannot change this value before our commit ends.
+        SELECT j.* INTO committed_job FROM public."Job" j JOIN public."RecruitmentSource" s ON
+            s."id" = j."sourceId" AND s."companyId" = j."companyId"
+        WHERE j."sourceId" = NEW."sourceId" AND j."dedupeKey" = committed_member->>'jobKey'
+        FOR SHARE OF j;
+        IF NOT FOUND THEN RAISE EXCEPTION 'JOB_DELTA_COMMIT_JOB_MISSING'; END IF;
+        IF NOT (
+            committed_job."lifecycleStatus"::text = committed_member->>'lifecycleStatus' AND
+            to_jsonb(committed_job."missingSuccessCount") = committed_member->'missingCount' AND
+            committed_job."visibleInFrontend" IS TRUE AND
+            public.job_persisted_projection_sha256(committed_job) = committed_member->>'jobProjectionSha256'
+        ) IS TRUE THEN RAISE EXCEPTION 'JOB_DELTA_COMMIT_PROJECTION_MISMATCH'; END IF;
+    END LOOP;
+    RETURN NULL;
+END;
+$delta_commit$;
+REVOKE ALL ON FUNCTION public.validate_job_delta_commit_projection() FROM PUBLIC;
+
+CREATE CONSTRAINT TRIGGER "CrawlBatchSourceResult_delta_commit_projection"
+AFTER UPDATE ON public."CrawlBatchSourceResult"
+DEFERRABLE INITIALLY DEFERRED
+FOR EACH ROW
+WHEN (OLD."atomicCommitState" = 'PENDING' AND NEW."atomicCommitState" = 'COMMITTED' AND
+    NEW."completenessState" = 'VERIFIED' AND NEW."completenessCertificate"->>'schemaVersion' = 'job-projection-delta-receipt-v1')
+EXECUTE FUNCTION public.validate_job_delta_commit_projection();
+
+-- The SQL48 catalog has one certificate-reading CHECK and one function (above).
+-- Preserve the CHECK's exact reason/count/grade/policy expression, substituting
+-- only its certificate operand. Install and validate its replacement before
+-- dropping the old definition, then retain the original public constraint name.
+DO $baseline_delta$
+DECLARE
+    old_definition text;
+    new_definition text;
+BEGIN
+    SELECT pg_get_constraintdef(c.oid) INTO old_definition FROM pg_catalog.pg_constraint c
+    WHERE c.conrelid = 'public."CrawlBatchSourceResult"'::regclass AND
+        c.conname = 'CrawlBatchSourceResult_baseline_transition_shape_check';
+    IF md5(old_definition) IS DISTINCT FROM '3467cccd71def5814f2e9d65c3320ea5' THEN
+        RAISE EXCEPTION 'JOB_DELTA_SQL48_BASELINE_CONSTRAINT_DRIFT';
+    END IF;
+    new_definition := replace(old_definition, '"completenessCertificate"',
+        'public.job_delta_effective_legacy_certificate("completenessCertificate", "completenessCertificateSha256", ' ||
+        'jsonb_build_object(''releaseCandidateId'',"releaseCandidateId",''batchId'',"batchId",''sourceId'',"sourceId",''sourceResultId'',"id"), "finishedAt")');
+    IF new_definition IS NOT DISTINCT FROM old_definition THEN
+        RAISE EXCEPTION 'JOB_DELTA_BASELINE_CERTIFICATE_OPERAND_MISSING';
+    END IF;
+    EXECUTE 'ALTER TABLE public."CrawlBatchSourceResult" ADD CONSTRAINT "CrawlBatchSourceResult_baseline_delta_checked" ' || new_definition;
+    ALTER TABLE public."CrawlBatchSourceResult" DROP CONSTRAINT "CrawlBatchSourceResult_baseline_transition_shape_check";
+    ALTER TABLE public."CrawlBatchSourceResult" RENAME CONSTRAINT "CrawlBatchSourceResult_baseline_delta_checked" TO "CrawlBatchSourceResult_baseline_transition_shape_check";
+END;
+$baseline_delta$;
+
+COMMIT;
