[Unit]
Description=Job Finder manual preview %i

[Service]
Type=oneshot
User=user
WorkingDirectory=/data/job-finder/app
EnvironmentFile=/data/job-finder/postgres.env
EnvironmentFile=/data/job-finder/runtime.env
Environment=JOBFINDER_STATE_ROOT=/data/job-finder
ExecStart=/data/job-finder/app/bin/node --import tsx runner-candidate/scripts/direct-manual.ts --request-id %i
TimeoutStartSec=8h
Restart=no
