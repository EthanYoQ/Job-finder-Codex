"""Fixed deployment-only I/O. Never allocates a round or invokes a producer.
Compiled as bytes inside the two reviewed functions artifacts, not imported from
a caller path. Uses the existing pinned CLI preflight and canonical generator.
"""
import hashlib,json,os,pathlib,stat,subprocess,sys,contextlib,fcntl
B=__BINDING_PY__
ROOT=pathlib.Path('/workspace/scratch/5e9614251709/job-finder-fixed-live-controller-v1')
CHECKOUT=ROOT/'runtime-checkout';PACKAGE=CHECKOUT/'tools/dot-auto-controller'
CANDIDATE=ROOT/'candidate';DISABLED=CANDIDATE/'functions-entry.js';ENABLED=CANDIDATE/'functions-entry.enabled.js'
PREFIX='tools/dot-auto-controller/'
CHUNK_BYTES=8192
def require(ok,code):
 if not ok:raise RuntimeError(code)
def sha(b):return hashlib.sha256(b).hexdigest()
def encoded(x):return json.dumps(x,ensure_ascii=True,separators=(',',':')).encode()
def parent_fd(path):
 require(path.is_absolute(),'ACTIVATION_PATH')
 fd=os.open('/',os.O_RDONLY|os.O_DIRECTORY|os.O_NOFOLLOW)
 try:
  for part in path.parts[1:-1]:
   require(part not in ('','.','..'),'ACTIVATION_PATH')
   nxt=os.open(part,os.O_RDONLY|os.O_DIRECTORY|os.O_NOFOLLOW,dir_fd=fd)
   try:
    s=os.fstat(nxt);require(s.st_uid in (0,os.getuid()) and not s.st_mode&0o022,'ACTIVATION_PARENT')
   except BaseException:os.close(nxt);raise
   os.close(fd);fd=nxt
  return fd
 except BaseException:os.close(fd);raise
def checked(path,maximum=8*1024*1024,mode=None):
 pfd=parent_fd(path)
 try:
  fd=os.open(path.name,os.O_RDONLY|os.O_NOFOLLOW|os.O_NONBLOCK,dir_fd=pfd)
  try:
   before=os.fstat(fd)
   require(stat.S_ISREG(before.st_mode) and before.st_uid==os.getuid() and before.st_nlink==1 and not before.st_mode&0o022 and before.st_size<=maximum and (mode is None or stat.S_IMODE(before.st_mode)==mode),'ACTIVATION_FILE')
   with os.fdopen(os.dup(fd),'rb') as f:data=f.read(maximum+1)
   ident=lambda s:(s.st_dev,s.st_ino,s.st_size,s.st_mtime_ns,s.st_ctime_ns)
   require(len(data)==before.st_size and ident(before)==ident(os.fstat(fd))==ident(os.stat(path.name,dir_fd=pfd,follow_symlinks=False)),'ACTIVATION_FILE_CHANGED')
   return data
  finally:os.close(fd)
 finally:os.close(pfd)
def absent():
 fd=parent_fd(ENABLED)
 try:
  try:os.stat(ENABLED.name,dir_fd=fd,follow_symlinks=False)
  except FileNotFoundError:return
  raise RuntimeError('ACTIVATION_OUTPUT_EXISTS')
 finally:os.close(fd)
def never_activated():
 marker=ROOT.parent/('.'+ROOT.name+'.lifecycle-owner')/'ACTIVATION_STARTED';fd=parent_fd(marker)
 try:
  try:os.stat(marker.name,dir_fd=fd,follow_symlinks=False)
  except FileNotFoundError:return
  raise RuntimeError('ACTIVATION_HISTORY_EXISTS')
 finally:os.close(fd)
def record_activation_started():
 # Permanent history, before enabled bytes. Same original EX lease and all
 # original registration/source checks are already held/passed here.
 lease=globals().get('LIFECYCLE_LEASE');require(lease is not None and lease.mode=='EX','ACTIVATION_LIFECYCLE_EX_REQUIRED');lease.check()
 marker=ROOT.parent/('.'+ROOT.name+'.lifecycle-owner')/'ACTIVATION_STARTED';fd=parent_fd(marker)
 try:
  out=os.open(marker.name,os.O_WRONLY|os.O_CREAT|os.O_EXCL|os.O_NOFOLLOW,0o400,dir_fd=fd)
  with os.fdopen(out,'wb') as f:
   f.write(encoded({'schemaVersion':1,'deploymentSha256':B['deploymentSha256'],'enabledEntrySha256':B['enabledEntrySha256']}));f.flush();os.fsync(f.fileno())
  os.fsync(fd)
 finally:os.close(fd)
def put(data):
 fd=parent_fd(ENABLED)
 try:
  out=os.open(ENABLED.name,os.O_WRONLY|os.O_CREAT|os.O_EXCL|os.O_NOFOLLOW,0o400,dir_fd=fd)
  # An uncertain/partial write is preserved and blocks activation retry.
  with os.fdopen(out,'wb') as f:f.write(data);f.flush();os.fsync(f.fileno())
  os.fsync(fd)
 finally:os.close(fd)
def pinned_module(path,digest):
 data=checked(path);require(sha(data)==digest,'ACTIVATION_EXECUTABLE_PIN')
 lease=globals().get('LIFECYCLE_LEASE')
 require(lease is not None and lease.mode=='EX','ACTIVATION_LIFECYCLE_EX_REQUIRED')
 lease.check()
 namespace={'__name__':'fixed_deployment_qualified_module','__file__':str(path),'LIFECYCLE_LEASE':lease}
 exec(compile(data,str(path),'exec'),namespace)
 return namespace
def transform(disabled):
 before=('const ACTIVATION=Object.freeze('+json.dumps({'enabled':False,'mode':'LIVE','deploymentSha256':B['deploymentSha256']},separators=(',',':'))+');\n').encode()
 after=before.replace(b'"enabled":false',b'"enabled":true',1)
 require(sha(disabled)==B['disabledEntrySha256'] and len(disabled)==B['disabledEntryBytes'],'ACTIVATION_DISABLED_PIN')
 require(disabled.startswith(before) and disabled.count(b'const ACTIVATION=')==1,'ACTIVATION_EXACT_PREFIX')
 enabled=after+disabled[len(before):]
 require(enabled[len(after):]==disabled[len(before):] and sha(enabled)==B['enabledEntrySha256'] and len(enabled)==B['enabledEntryBytes'],'ACTIVATION_ENABLED_PIN')
 return enabled
def source_inventory():
 raw=checked(ROOT/'deployments'/(B['sourceManifestSha256']+'.source-manifest.json'),mode=0o400)
 require(sha(raw)==B['sourceManifestSha256'],'ACTIVATION_SOURCE_MANIFEST')
 m=json.loads(raw);require(m['schemaVersion']==1 and m['packagePrefix']==PREFIX and m['files']==len(m['entries']),'ACTIVATION_SOURCE_MANIFEST')
 env={'PATH':'/usr/bin:/bin','LANG':'C.UTF-8'}
 head=subprocess.run(['/usr/bin/git','rev-parse','HEAD'],cwd=CHECKOUT,env=env,capture_output=True)
 require(head.returncode==0 and head.stdout.decode().strip()==B['remoteCommit']['commitSha'],'ACTIVATION_REMOTE_COMMIT_LOCAL_BINDING')
 result=subprocess.run(['/usr/bin/git','ls-tree','-rz','--full-tree','HEAD','--',PREFIX],cwd=CHECKOUT,env=env,capture_output=True)
 require(result.returncode==0,'ACTIVATION_SOURCE_GIT')
 actual={}
 for line in result.stdout.split(b'\0'):
  if not line:continue
  meta,path=line.split(b'\t');mode,kind,blob=meta.decode().split(' ')
  require(kind=='blob' and path.decode() not in actual,'ACTIVATION_SOURCE_GIT')
  actual[path.decode()]=(mode,blob)
 expected={}
 for e in m['entries']:
  p=e['path'];require(p.startswith(PREFIX) and all(x not in ('','.','..') for x in p.split('/')) and p not in expected,'ACTIVATION_SOURCE_PATH')
  data=checked(CHECKOUT/p,maximum=16*1024*1024)
  require(len(data)==e['bytes'] and sha(data)==e['sha256'],'ACTIVATION_SOURCE_BYTES')
  expected[p]=(e['mode'],e['gitBlobSha1'])
 require(actual==expected,'ACTIVATION_COMPLETE_SOURCE_SET')
def qualify():
 lease=globals().get('LIFECYCLE_LEASE')
 require(lease is not None and lease.mode=='EX','ACTIVATION_LIFECYCLE_EX_REQUIRED')
 lease.check()
 absent();never_activated();source_inventory()
 # Local identity never substitutes for the independently obtained remote fact.
 os.environ['JOBFINDER_FIXED_LOCAL_MODE']='LIVE'
 builder=pinned_module(PACKAGE/'fixed-host/sequence/build-functions-entry.py',B['builderSha256'])
 inputs=builder['load_source_inputs']()
 release_bytes=checked(ROOT/'deployments'/(B['deploymentSha256']+'.json'),mode=0o400)
 require(sha(release_bytes)==B['deploymentSha256'] and json.loads(release_bytes)==B['release'],'ACTIVATION_RELEASE_CHANGED')
 builder['validate_release'](inputs,B['release'])
 cli=None
 for profile in ('takeda','biogen'):
  d=B['release']['profiles'][profile];pin=B['profiles'][profile]
  os.environ['JOBFINDER_FIXED_DEPLOYMENT_SHA256']=pin['deploymentSha256']
  current=pinned_module(CANDIDATE/('fixed-'+profile+'-preimport-launch.py'),pin['cliSha256'])
  derived=current['preflight']()
  require(derived['expectedRow']==B['deployment']['expectedRow'] and derived['control']['build']==B['deployment']['build'],'ACTIVATION_DERIVED_IDENTITY')
  if cli is None:cli=current
 disabled=checked(DISABLED);rendered=builder['render_entry'](inputs,B['release'])
 require(disabled==rendered,'ACTIVATION_CANONICAL_DISABLED_BYTES')
 enabled=transform(disabled)
 return cli,enabled
def main():
 require(B is not None and len(sys.argv)==3 and sys.argv[1] in ('qualify','commit','read'),'ACTIVATION_OPERATION')
 op=sys.argv[1]
 if op=='read':
  require(sys.argv[2].isdigit(),'LOADER_OFFSET');offset=int(sys.argv[2])
  data=checked(ENABLED,mode=0o400)
  require(sha(data)==B['enabledEntrySha256'] and len(data)==B['enabledEntryBytes'] and 0<=offset<len(data) and offset%CHUNK_BYTES==0,'LOADER_ARTIFACT_PIN')
  part=data[offset:offset+CHUNK_BYTES].decode('ascii')
  result={'kind':'FIXED_ENABLED_CHUNK','sha256':sha(data),'totalBytes':len(data),'offset':offset,'next':offset+len(part),'text':part}
 else:
  require(sys.argv[2]=='0','ACTIVATION_OPERATION')
  cli,enabled=qualify()
  if op=='qualify':result={'kind':'FIXED_ACTIVATION_QUALIFIED','bindingSha256':B['bindingSha256'],'disabledSha256':B['disabledEntrySha256'],'enabledSha256':B['enabledEntrySha256'],'enabledBytes':len(enabled)}
  else:
   raw=sys.stdin.buffer.read(2*1024*1024+1);require(len(raw)<=2*1024*1024,'ACTIVATION_INPUT_SIZE');packet=cli['decode'](raw)
   require(set(packet)=={'schemaVersion','rawBytes','rawSha256','checkedAt'} and packet['schemaVersion']==1 and type(packet['rawBytes']) is str and sha(packet['rawBytes'].encode())==packet['rawSha256'],'ACTIVATION_RAW_BINDING')
   rows=cli['tool_rows'](cli['decode'](packet['rawBytes'].encode()))
   require(len(rows)==1 and all(rows[0]['candidate'].get(k)==v for k,v in B['deployment']['expectedRow'].items()) and rows[0]['checkedAt']==packet['checkedAt'],'ACTIVATION_REGISTRATION_16')
   cli['age'](packet['checkedAt'],60)
   # Re-read exact executable input after all awaited/subprocess qualification.
   require(transform(checked(DISABLED))==enabled,'ACTIVATION_INPUT_CHANGED')
   record_activation_started();put(enabled)
   result={'kind':'FIXED_DEPLOYMENT_ACTIVATED','disabledSha256':B['disabledEntrySha256'],'enabledSha256':B['enabledEntrySha256'],'enabledBytes':len(enabled),'rawSha256':packet['rawSha256'],'checkedAt':packet['checkedAt'],'onlyActivationBooleanChanged':True}
 print(json.dumps(result,separators=(',',':')))

# Additive install guard. READY is only the absence of an install block;
# all original source, remote, preflight, freshness and byte checks still apply.
@contextlib.contextmanager
def install_guard():
 lock=ROOT/'install.lock';pfd=parent_fd(lock)
 try:
  fd=os.open(lock.name,os.O_RDONLY|os.O_NOFOLLOW|os.O_NONBLOCK,dir_fd=pfd)
  try:
   original=os.fstat(fd);parent=os.fstat(pfd)
   def validate_lock():
    now=os.fstat(fd);at=os.stat(lock.name,dir_fd=pfd,follow_symlinks=False)
    require(stat.S_ISREG(now.st_mode) and now.st_uid==os.getuid() and now.st_nlink==1 and stat.S_IMODE(now.st_mode)==0o600 and now.st_size==0,'ACTIVATION_INSTALL_LOCK_METADATA')
    require((now.st_dev,now.st_ino)==(original.st_dev,original.st_ino)==(at.st_dev,at.st_ino),'ACTIVATION_INSTALL_LOCK_INODE')
    current=ROOT.lstat();require(stat.S_ISDIR(current.st_mode) and (current.st_dev,current.st_ino)==(parent.st_dev,parent.st_ino),'ACTIVATION_INSTALL_ROOT_INODE')
   def incomplete_guard():
    try:os.stat('install-incomplete',dir_fd=pfd,follow_symlinks=False)
    except FileNotFoundError:pass
    else:raise RuntimeError('ACTIVATION_INSTALL_INCOMPLETE')
    try:os.stat('install-attempt',dir_fd=pfd,follow_symlinks=False)
    except FileNotFoundError:return
    raise RuntimeError('ACTIVATION_INSTALL_INCOMPLETE')
   validate_lock();fcntl.flock(fd,fcntl.LOCK_SH);validate_lock();incomplete_guard()
   yield
   validate_lock();incomplete_guard()
  finally:os.close(fd)
 finally:os.close(pfd)
_original_main=main
def main():
 # A null/default binding cannot open or create the install lock.
 require(B is not None and len(sys.argv)==3 and sys.argv[1] in ('qualify','commit','read'),'ACTIVATION_OPERATION')
 with install_guard():return _original_main()

if __name__=='__main__':main()
