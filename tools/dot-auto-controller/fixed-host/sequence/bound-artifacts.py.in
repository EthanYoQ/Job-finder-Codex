"""Closed two-profile artifact map within the original EX install transaction."""
import hashlib,json,pathlib,sys,types
PREFIX='tools/dot-auto-controller/'
def require(ok,code):
 if not ok:raise RuntimeError(code)
def sha(x):return hashlib.sha256(x).hexdigest()
def load(path,raw,name,values=None):
 m=types.ModuleType(name);m.__file__=str(path);sys.modules[name]=m
 if values:m.__dict__.update(values)
 exec(compile(raw,str(path),'exec'),m.__dict__);return m
def prepare(stage,pins,control,domain,lifecycle_source,remote_fact):
 package=pathlib.Path(stage)/'runtime-checkout'/PREFIX
 raw_manifest=pathlib.Path(pins['sourceManifestPath']).read_bytes()
 require(sha(raw_manifest)==pins['sourceManifestSha256'],'BOUND_SOURCE_MANIFEST')
 manifest=json.loads(raw_manifest);entries={e['path']:e for e in manifest['entries']}
 require(len(entries)==manifest['files']==pins['sourceFiles'],'BOUND_SOURCE_CLOSED_SET')
 def source(relative):
  p=package/relative;raw=p.read_bytes();entry=entries[PREFIX+relative]
  require(len(raw)==entry['bytes'] and sha(raw)==entry['sha256'],'BOUND_MEASURED_SOURCE');return raw
 release_bytes=control['deploymentBytes'].encode('ascii');release=json.loads(release_bytes)
 require(release['kind']=='CLOSED_TWO_SOURCE_RELEASE','BOUND_CLOSED_RELEASE')
 for d in release['profiles'].values():
  require(d['expectedRow']==control['expectedRow'] and d['build']==pins['buildIdentity'] and d['build']['commitSha']==control['commitSha'] and d['packageManifestSha256']==pins['sourceManifestSha256'] and d['lockSha256']==pins['lockSha256'],'BOUND_MEASURED_DEPLOYMENT')
 require(remote_fact['repository']==control['repo'] and remote_fact['commitSha']==control['commitSha'],'BOUND_OFFICIAL_COMMIT')
 measured={'sourceManifestSha256':pins['sourceManifestSha256'],'builderSha256':sha(source('fixed-host/sequence/build-functions-entry.py')),'canonicalDefaultSha256':sha(source('fixed-host/sequence/functions-entry.js'))}
 activation=load(package/'fixed-host/sequence/activation-renderer.py',source('fixed-host/sequence/activation-renderer.py'),'sequence_original_activation',{'ACTIVATION_PINS':measured})
 result=activation.render(package,release_bytes,remote_fact);binding=result['binding']
 builder,inputs=activation.source_inputs(package)
 helper=source('fixed-host/sequence/local-activation.py.in').decode().replace('__BINDING_PY__',repr(binding)).encode()
 generator=load(package/'fixed-host/scripts/build-lifecycle-artifacts.py',source('fixed-host/scripts/build-lifecycle-artifacts.py'),'sequence_owner_renderer')
 sources={}
 for directory in ('functions','lifecycle'):
  for p in (package/'fixed-host'/directory).iterdir():
   if p.is_file():sources['fixed-host/'+directory+'/'+p.name]=source('fixed-host/'+directory+'/'+p.name)
 sources['fixed-host/lifecycle/holder.py.in']=source('fixed-host/sequence/holder.py.in')
 sources['fixed-host/functions/lifecycle-loader.template.js']=source('fixed-host/sequence/lifecycle-loader.template.js')
 query=source('fixed-host/functions/bootstrap-query.sql.template').decode().replace('__JOBFINDER_CANDIDATE_ID__',control['expectedRow']['id'])
 owner=generator.render_fixed_owner_bundle(sources,domain,binding['enabledEntrySha256'],binding['enabledEntryBytes'],binding['cliSha256'],sha(helper),binding,query)
 require(owner['lifecycle_lock.py']==lifecycle_source.encode(),'BOUND_FIXED_LOCK_SOURCE')
 owner.pop('cli-entry.py')
 owner['binding.json']=json.dumps({'domain':domain,'moduleSha256':sha(owner['lifecycle_lock.py']),'releaseSha256':binding['deploymentSha256'],'profiles':binding['profiles']},sort_keys=True,separators=(',',':')).encode()
 owner['local-activation.py']=helper
 target={'candidate/functions-entry.js':result['disabled'],'deployments/'+binding['deploymentSha256']+'.json':release_bytes,'deployments/'+pins['sourceManifestSha256']+'.manifest.json':raw_manifest,'deployments/'+pins['sourceManifestSha256']+'.source-manifest.json':raw_manifest}
 for name in builder.ORDER:
  for leaf,raw in builder.render_cli(inputs,name).items():target['candidate/'+leaf]=raw
  owner['cli-'+name+'.py']=builder.render_stable_cli(inputs,name)
  target['deployments/'+binding['profiles'][name]['deploymentSha256']+'.json']=builder.encoded(release['profiles'][name]).encode()
 return {'targetFiles':target,'ownerFiles':owner,'qualifyHelperName':'local-activation.py'}
