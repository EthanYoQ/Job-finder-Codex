#!/usr/bin/python3
"""Stable CLI entry. Its fixed sibling binding precedes any candidate read.
Provision this outside the replaceable target; never run the candidate directly.
"""
import hashlib,json,os,pathlib,stat,sys,types
PROFILE=__SEQUENCE_PROFILE__
def require(ok,code):
    if not ok:raise RuntimeError(code)
def checked(path,digest=None):
    for parent in path.parents:
        st=parent.lstat();require(stat.S_ISDIR(st.st_mode) and not st.st_mode&0o022 and st.st_uid in (0,os.getuid()),'LIFECYCLE_STABLE_PARENT')
    fd=os.open(path,os.O_RDONLY|os.O_NOFOLLOW|os.O_NONBLOCK)
    try:
        st=os.fstat(fd);require(stat.S_ISREG(st.st_mode) and st.st_uid==os.getuid() and st.st_nlink==1 and not st.st_mode&0o022 and st.st_size<=4*1024*1024,'LIFECYCLE_STABLE_FILE')
        with os.fdopen(os.dup(fd),'rb') as stream:raw=stream.read(4*1024*1024+1)
        sig=lambda s:(s.st_dev,s.st_ino,s.st_size,s.st_mtime_ns,s.st_ctime_ns)
        require(len(raw)==st.st_size and sig(st)==sig(os.fstat(fd))==sig(path.lstat()),'LIFECYCLE_STABLE_CHANGED')
        if digest is not None:require(hashlib.sha256(raw).hexdigest()==digest,'LIFECYCLE_STABLE_PIN')
        return raw
    finally:os.close(fd)
def main():
    stable=pathlib.Path(__file__).absolute().parent
    require(stable.name.endswith('.lifecycle-owner') or stable.name=='stable','LIFECYCLE_STABLE_LOCATION')
    binding=json.loads(checked(stable/'binding.json'))
    require(type(binding) is dict and set(binding)=={'domain','moduleSha256','profiles','releaseSha256'} and set(binding['profiles'])=={'takeda','biogen','hengrui','ucb'},'LIFECYCLE_STABLE_BINDING')
    module_path=stable/'lifecycle_lock.py';raw=checked(module_path,binding['moduleSha256'])
    module=types.ModuleType('fixed_cli_lifecycle');module.__file__=str(module_path);sys.modules[module.__name__]=module;exec(compile(raw,str(module_path),'exec'),module.__dict__)
    domain=module.Domain.from_json(json.dumps(binding['domain']))
    with domain.acquire('SH') as lease:
        for name in ('install-incomplete','install-attempt'):
            require(not os.path.lexists(domain.target/name),'LIFECYCLE_INSTALL_INCOMPLETE')
        profile=binding['profiles'][PROFILE]
        require(set(profile)=={'cliSha256','deploymentSha256'} and os.environ.get('JOBFINDER_FIXED_DEPLOYMENT_SHA256')==profile['deploymentSha256'],'SEQUENCE_PROFILE_BINDING')
        release=checked(domain.target/'deployments'/(binding['releaseSha256']+'.json'),binding['releaseSha256'])
        document=json.loads(release)
        require(document['order']==['takeda','biogen','hengrui','ucb'] and document['kind']=='CLOSED_FOUR_SOURCE_RELEASE' and hashlib.sha256(json.dumps(document['profiles'][PROFILE],ensure_ascii=True,separators=(',',':')).encode()).hexdigest()==profile['deploymentSha256'],'SEQUENCE_RELEASE_BINDING')
        path=domain.target/'candidate'/('fixed-'+PROFILE+'-preimport-launch.py')
        raw=checked(path,profile['cliSha256']);lease.check();lease.prepare_exec()
        # This exact byte string was read only after SH. No import re-opens it.
        exec(compile(raw,str(path),'exec'),{'__name__':'__main__','__file__':str(path),'LIFECYCLE_LEASE':lease})
if __name__=='__main__':main()
