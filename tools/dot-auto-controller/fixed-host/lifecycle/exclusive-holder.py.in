#!/usr/bin/python3
"""Fixed activation transaction owner: EX covers qualify, DB await and commit.
The pinned helper is compiled while EX is held and runs in this same process.
There is no detached permit, arbitrary command or caller-selected target.
"""
import hashlib,io,json,os,pathlib,stat,sys,types,termios,contextlib
BINDING=__FIXED_LIFECYCLE_BINDING__
def require(ok,code):
    if not ok:raise RuntimeError(code)
def read(path,digest):
    for parent in path.parents:
        st=parent.lstat();require(stat.S_ISDIR(st.st_mode) and not st.st_mode&0o022 and st.st_uid in (0,os.getuid()),'EXCLUSIVE_PARENT')
    fd=os.open(path,os.O_RDONLY|os.O_NOFOLLOW)
    try:
        st=os.fstat(fd);require(stat.S_ISREG(st.st_mode) and st.st_uid==os.getuid() and st.st_nlink==1 and not st.st_mode&0o022,'EXCLUSIVE_FILE')
        with os.fdopen(os.dup(fd),'rb') as f:raw=f.read(4*1024*1024)
        sig=lambda s:(s.st_dev,s.st_ino,s.st_size,s.st_mtime_ns,s.st_ctime_ns)
        require(len(raw)==st.st_size and sig(st)==sig(os.fstat(fd))==sig(path.lstat()) and hashlib.sha256(raw).hexdigest()==digest,'EXCLUSIVE_FILE_PIN')
        return raw
    finally:os.close(fd)
def emit(value):print(json.dumps(value,separators=(',',':')),flush=True)
def main():
    require(type(BINDING) is dict and len(sys.argv)==1,'EXCLUSIVE_UNQUALIFIED')
    if sys.stdin.isatty():
        attrs=termios.tcgetattr(0);attrs[3]&=~termios.ECHO;termios.tcsetattr(0,termios.TCSANOW,attrs)
    path=pathlib.Path(BINDING['modulePath']);raw=read(path,BINDING['moduleSha256'])
    module=types.ModuleType('exclusive_lifecycle');module.__file__=str(path);sys.modules[module.__name__]=module;exec(compile(raw,str(path),'exec'),module.__dict__)
    domain=module.Domain.from_json(json.dumps(BINDING['domain']))
    with module.exclusive_transaction(domain) as lease:
        helper=pathlib.Path(BINDING['helperPath']);raw=read(helper,BINDING['helperSha256'])
        ns={'__name__':'fixed_qualified_activation','__file__':str(helper),'LIFECYCLE_LEASE':lease}
        exec(compile(raw,str(helper),'exec'),ns)
        require(callable(ns.get('main')),'EXCLUSIVE_HELPER_API')
        serial=0;qualified=False;committed=False
        emit({'kind':'EXCLUSIVE_READY','serial':0})
        while True:
            line=sys.stdin.buffer.readline(4*1024*1024+1)
            if not line:return 78
            require(len(line)<=4*1024*1024 and line.endswith(b'\n'),'EXCLUSIVE_INPUT_SIZE')
            command=json.loads(line);lease.check();serial+=1
            require(type(command) is dict and set(command)=={'op','serial','payload'} and command['serial']==serial,'EXCLUSIVE_COMMAND')
            op=command['op']
            if op=='abandon':emit({'kind':'EXCLUSIVE_UNKNOWN','serial':serial});return 78
            if op=='finish':
                require(committed,'EXCLUSIVE_COMMIT_REQUIRED');lease.finish_mutation_from_owned_transaction();emit({'kind':'EXCLUSIVE_FINISHED','serial':serial});return 0
            require((op=='qualify' and not qualified and command['payload'] is None) or (op=='commit' and qualified and not committed),'EXCLUSIVE_OPERATION_ORDER')
            # The exact original helper executes all candidate reads/writes in
            # this EX context. Inputs only restrict its existing DB checks.
            saved_argv,saved_stdin=sys.argv,sys.stdin
            output=io.StringIO()
            try:
                sys.argv=[str(helper),op,'0']
                sys.stdin=io.TextIOWrapper(io.BytesIO(json.dumps(command['payload']).encode()))
                with contextlib.redirect_stdout(output):ns['main']()
            finally:sys.argv=saved_argv;sys.stdin=saved_stdin
            lease.check();result=json.loads(output.getvalue())
            if op=='qualify':qualified=True
            else:committed=True
            emit({'kind':'EXCLUSIVE_RESULT','serial':serial,'operation':op,'result':result})
if __name__=='__main__':
    try:sys.exit(main())
    except BaseException as error:
        if isinstance(error,SystemExit):raise
        emit({'kind':'EXCLUSIVE_HOLD','reason':str(error)});sys.exit(78)
