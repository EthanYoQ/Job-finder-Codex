#!/usr/bin/python3
"""Fixed v3 deployment and round adapter. Data restriction only, never a permit.
Runtime code, deployment JSON and the outer trusted composition are separate.
LIVE requires a newly reviewed, immutable real deployment; default is disabled.
"""
import datetime,hashlib,json,os,pathlib,re,stat,subprocess,sys,uuid,fcntl
BASE=pathlib.Path('__JOBFINDER_FIXED_DEPLOYMENT_ROOT__')
CANDIDATE=BASE/'candidate';DEPLOYMENTS=BASE/'deployments';ROUNDS=BASE/'rounds'
CHECKOUT=BASE/'runtime-checkout';PACKAGE=CHECKOUT/'tools/dot-auto-controller';VENDOR=PACKAGE/'vendor/c60-source';HOST=VENDOR/'ops/cloud-pilot-host'
RUNTIME=BASE/'connector-host-runtime';NODE=RUNTIME/'node';BINDINGS=BASE/'connector-host-bindings'
TASK=BASE;PRIVATE=BASE/'unselected';ROUND_ROOT=PRIVATE;ROUND_ID=None
NODE_SHA='fde6a4bf8d0562f7751d1a2d6cb9b417c4cfe107bbcb0aa3e9a24e125e348f48'
PROJECT='yiopvxysxrtrnvqxwgbx';SOURCE_ID='source-takeda-china-social';SOURCE_HASH='048f616f00b5ed016f075f4204a2ad749457d68a3f078a9e7bde0fae2186b61f'
SHA=re.compile('[a-f0-9]{64}');RID=re.compile('round-[a-f0-9]{32}');UUID=re.compile('[0-9a-f]{8}-(?:[0-9a-f]{4}-){3}[0-9a-f]{12}');UTC=datetime.timezone.utc
REGISTRATION_FIELDS=['id','goalId','version','commitSha','migrationVersion','schemaHash','dbSnapshotHash','rosterHash','sourcePlanHash','sourceConfigHash','adapterBundleHash','sourceTreeHash','runtimeTreeHash','oracleVersion','minimumStableCompanyCount','status']
def require(ok,code):
    if not ok: raise RuntimeError(code)
def sha(b): return hashlib.sha256(b).hexdigest()
def encoded(value): return json.dumps(value,ensure_ascii=False,separators=(',',':')).encode()
def exact(value,keys): return type(value) is dict and set(value)==set(keys)
def decode(data):
    def pairs(items):
        out={}
        for k,v in items:
            require(k not in out and k not in ('__proto__','prototype','constructor'),'FIXED_JSON_KEYS');out[k]=v
        return out
    return json.loads(data.decode('utf-8'),object_pairs_hook=pairs,parse_constant=lambda _:(_ for _ in ()).throw(RuntimeError('FIXED_JSON_CONSTANT')))
def directories(file):
    require(os.getuid()>0 and sys.platform=='linux','FIXED_PLATFORM')
    out=[]
    for p in file.parents:
        s=p.lstat();private=p in (BASE,DEPLOYMENTS,ROUNDS,ROUND_ROOT,PRIVATE,RUNTIME,BINDINGS,PRIVATE/'relay',PRIVATE/'artifacts')
        require(stat.S_ISDIR(s.st_mode) and not stat.S_ISLNK(s.st_mode) and not s.st_mode&0o022 and s.st_uid in (os.getuid(),0),'FIXED_DIRECTORY')
        if private: require(s.st_uid==os.getuid() and stat.S_IMODE(s.st_mode)==0o700,'FIXED_PRIVATE_DIRECTORY')
        out.append((str(p),s.st_dev,s.st_ino,s.st_uid,s.st_gid,s.st_mode))
    return out
def identity(s): return (s.st_dev,s.st_ino,s.st_uid,s.st_gid,s.st_mode,s.st_nlink,s.st_size,s.st_mtime_ns,s.st_ctime_ns)
def checked(file,mode=None,maximum=16*1024*1024):
    before_dirs=directories(file);s=file.lstat()
    def valid(s):return stat.S_ISREG(s.st_mode) and s.st_uid==os.getuid() and s.st_nlink==1 and not s.st_mode&0o022 and (mode is None or stat.S_IMODE(s.st_mode)==mode) and 0<=s.st_size<=maximum
    require(valid(s),'FIXED_FILE');fd=os.open(file,os.O_RDONLY|os.O_NOFOLLOW|os.O_NONBLOCK)
    try:
        require(identity(s)==identity(os.fstat(fd)),'FIXED_FILE_CHANGED')
        with os.fdopen(os.dup(fd),'rb') as f:data=f.read(maximum+1)
        require(len(data)==s.st_size and identity(s)==identity(os.fstat(fd))==identity(file.lstat()) and before_dirs==directories(file),'FIXED_FILE_CHANGED')
        return data
    finally:os.close(fd)
def put(file,data,mode=0o600):
    directories(file);data=data if isinstance(data,bytes) else encoded(data)
    fd=os.open(file,os.O_WRONLY|os.O_CREAT|os.O_EXCL|os.O_NOFOLLOW,mode)
    with os.fdopen(fd,'wb') as f:f.write(data);f.flush();os.fsync(f.fileno())
    return {'sha256':sha(data),'bytes':len(data)}
def canonical(v):return json.dumps(v,ensure_ascii=False,sort_keys=True,separators=(',',':'))
def mode():return os.environ.get('JOBFINDER_FIXED_LOCAL_MODE','DISABLED')
def selector():
    x=os.environ.get('JOBFINDER_FIXED_DEPLOYMENT_SHA256','');require(type(x) is str and SHA.fullmatch(x),'FIXED_DEPLOYMENT_SELECTOR');return x

def config():
    digest=selector();raw=checked(DEPLOYMENTS/(digest+'.json'),0o400)
    require(sha(raw)==digest,'FIXED_DEPLOYMENT_HASH');c=decode(raw)
    require(exact(c,['schemaVersion','kind','projectId','sourceId','sourceConfigSha256','candidate','databaseIdentity','build','expectedRow','lockSha256','packageManifestSha256','preflightSha256','recoveryHelperSha256','fixturePreloadSha256']),'FIXED_DEPLOYMENT_KEYS')
    require(c['schemaVersion']==1 and c['projectId']==PROJECT and c['sourceId']==SOURCE_ID and c['sourceConfigSha256']==SOURCE_HASH,'FIXED_DEPLOYMENT_SCOPE')
    require(c['kind']=={'TEST_ONLY':'TEST_ONLY_UNREGISTERED','LIVE':'LIVE_DEPLOYMENT'}[mode()],'FIXED_DEPLOYMENT_MODE')
    ca=c['candidate'];b=c['build'];db=c['databaseIdentity'];row=c['expectedRow']
    require(exact(ca,['id','goalId','version']) and type(ca['id']) is str and re.fullmatch('[A-Za-z0-9][A-Za-z0-9._-]{0,127}',ca['id']) and ca['goalId']=='jobfinder-portable-required-40' and type(ca['version']) is int and 0<ca['version']<=2147483647,'FIXED_CANDIDATE')
    require(exact(b,['schemaVersion','commitSha','sourceTreeSha256','runtimeTreeSha256','contentSha256']) and b['schemaVersion']==2 and re.fullmatch('[a-f0-9]{40}',b['commitSha']) and all(type(b[k]) is str and SHA.fullmatch(b[k]) for k in ('sourceTreeSha256','runtimeTreeSha256','contentSha256')) and b['contentSha256']==sha(encoded({k:b[k] for k in ('schemaVersion','commitSha','sourceTreeSha256','runtimeTreeSha256')})),'FIXED_BUILD')
    require(exact(db,['migrationVersion','schemaHash','dbSnapshotHash']) and db['migrationVersion']=='20261006172300_job_projection_delta_contract' and db['schemaHash']=='91ac87fa179ae06c7441141601fd106c5cb636ab739351d5722bed5de151dc3a' and SHA.fullmatch(db['dbSnapshotHash']),'FIXED_DATABASE_PROFILE')
    require(exact(row,REGISTRATION_FIELDS) and all(row[k]==v for k,v in {**ca,**db,'commitSha':b['commitSha'],'sourceTreeHash':b['sourceTreeSha256'],'runtimeTreeHash':b['runtimeTreeSha256'],'status':'BUILDING','oracleVersion':'staged-official-source-v1','minimumStableCompanyCount':41}.items()),'FIXED_REGISTRATION_16')
    for k in ['lockSha256','packageManifestSha256','preflightSha256','recoveryHelperSha256']:require(type(c[k]) is str and SHA.fullmatch(c[k]),'FIXED_DEPLOYMENT_PIN')
    if mode()=='LIVE':
        require(c['fixturePreloadSha256'] is None and not ca['id'].startswith(('fixed-functions-','synthetic-')) and b['commitSha']!='1'*40 and not b['commitSha'].startswith('d02f4f5') and db['dbSnapshotHash']!='e'*64,'FIXED_REAL_DEPLOYMENT_REQUIRED')
    else:require(ca['id']=='fixed-functions-v4-unregistered' and type(c['fixturePreloadSha256']) is str and SHA.fullmatch(c['fixturePreloadSha256']),'FIXED_TEST_DEPLOYMENT')
    require(sha(checked(CANDIDATE/'fixed-preflight.mjs',0o644))==c['preflightSha256'] and sha(checked(CANDIDATE/'fixed-recovery-helper.mts',0o644))==c['recoveryHelperSha256'],'FIXED_TRUSTED_HELPER_PIN')
    if mode()=='TEST_ONLY':require(sha(checked(CANDIDATE/'fixed-source-fixture.cjs',0o644))==c['fixturePreloadSha256'],'FIXED_TEST_PRELOAD_PIN')
    return c

def select_round(round_id):
    global ROUND_ID,ROUND_ROOT,PRIVATE
    require(type(round_id) is str and RID.fullmatch(round_id),'FIXED_ROUND_SELECTOR')
    ROUND_ID=round_id;ROUND_ROOT=ROUNDS/round_id;PRIVATE=ROUND_ROOT/'connector-host-task'
    directories(PRIVATE/'scope-check')
def batch_id(round_id):return 'fixed-v4-'+round_id[6:]
def query(candidate_id):return 'BEGIN READ ONLY; SET LOCAL statement_timeout=\'4s\'; SELECT clock_timestamp() AS "checkedAt",to_jsonb(r) AS candidate FROM public."ReleaseCandidate" r WHERE id=\''+candidate_id+'\'; COMMIT;\n'
def node_env(binding=None):
    e={'PATH':str(RUNTIME)+':/usr/bin:/bin','LANG':'C.UTF-8','TZ':'UTC','TSX_DISABLE_CACHE':'1','NODE_DISABLE_COMPILE_CACHE':'1','JOBFINDER_CLOUD_SOURCE_ID':SOURCE_ID,'JOBFINDER_FIXED_LOCAL_MODE':mode(),'JOBFINDER_FIXED_DEPLOYMENT_SHA256':selector()}
    if binding:e['JOBFINDER_CONNECTOR_HOST_SHA256']=binding
    if ROUND_ID:e['JOBFINDER_CONNECTOR_ROUND_ID']=ROUND_ID
    return e

# Existing Node transport and original bounded runtime settings only. No values
# are logged, persisted, normalized, defaulted, or accepted through CLI/config.
# Node startup and the existing bounded parsers retain all original semantics.
PRODUCER_INHERITED_ENVIRONMENT_NAMES=(
    'NODE_USE_ENV_PROXY','HTTP_PROXY','HTTPS_PROXY','NO_PROXY',
    'http_proxy','https_proxy','no_proxy','NODE_EXTRA_CA_CERTS',
    'SSL_CERT_FILE','SSL_CERT_DIR','NODE_USE_SYSTEM_CA',
    'P0_SOURCE_HTTP_TIMEOUT_MS','P0_SOURCE_ATTEMPT_TIMEOUT_MS',
    'P0_SCHEDULED_ATTEMPT_TIMEOUT_MS','P0_BROWSER_TIMEOUT_MS',
    'P0_HCM_CLOUD_BROWSER_SETTLE_MS')
def approved_producer_environment(parent_environment):
    return {name:parent_environment[name] for name in PRODUCER_INHERITED_ENVIRONMENT_NAMES if name in parent_environment}

def preflight(op='derive'):
    c=config();require(sha(checked(NODE,maximum=150*1024*1024))==NODE_SHA,'FIXED_NODE_PIN')
    r=subprocess.run([str(NODE),str(CANDIDATE/'fixed-preflight.mjs'),op],cwd=VENDOR,env=node_env(),capture_output=True)
    require(r.returncode==0,'FIXED_PREFLIGHT:'+r.stderr.decode(errors='replace')[-1800:]);d=decode(r.stdout)
    if op=='derive':require(d['expectedRow']==c['expectedRow'],'FIXED_DERIVED_REGISTRATION')
    return d

def public_prepared(s):return {k:s[k] for k in ('kind','mode','roundId','seed','cfg','bootstrap','qualification')}
def state(*,historical_diagnostic=False):
    c=config();s=decode(checked(PRIVATE/'prepared.json',0o600))
    require(exact(s,['kind','mode','roundId','seed','cfg','bootstrap','qualification','expectedRow','control','bindingSha256','preparedAt','configSha256']) and s['kind']=='FIXED_PREFLIGHT' and s['mode']==mode() and s['roundId']==ROUND_ID and s['configSha256']==selector(),'FIXED_STATE')
    seed=s['seed'];require(exact(seed,['projectId','candidateId','sourceId','batchId','buildSha256','launchChallenge']) and seed['projectId']==PROJECT and seed['candidateId']==c['candidate']['id'] and seed['sourceId']==SOURCE_ID and seed['batchId']==batch_id(ROUND_ID) and seed['buildSha256']==c['build']['contentSha256'] and type(seed['launchChallenge']) is str and SHA.fullmatch(seed['launchChallenge']),'FIXED_SEED')
    require(decode(checked(PRIVATE/'fixed-seed.json',0o600))==seed,'FIXED_SEED_BYTES')
    require(type(s['bindingSha256']) is str and SHA.fullmatch(s['bindingSha256']),'FIXED_BINDING_SELECTOR');raw=checked(BINDINGS/(s['bindingSha256']+'.json'),0o400);require(sha(raw)==s['bindingSha256'],'FIXED_BINDING_HASH')
    expected_cfg={'repo':str(VENDOR),'root':str(HOST),'project':PROJECT,'sourceId':SOURCE_ID,'mode':'NATIVE_PORTABLE_CONNECTOR_V1','bindingSha256':s['bindingSha256'],'roundId':ROUND_ID,'taskRoot':str(PRIVATE),'relayDirectory':str(PRIVATE/'relay')}
    require(s['cfg']==expected_cfg,'FIXED_CFG')
    expected_qualification={'configSha256':selector(),'packageManifestSha256':c['packageManifestSha256'],'build':c['build'],'candidate':c['candidate'],'expectedRowSha256':sha(canonical(c['expectedRow']).encode()),'kind':c['kind']}
    require(s['qualification']==expected_qualification,'FIXED_QUALIFICATION')
    q=query(c['candidate']['id']);require(s['bootstrap']=={'projectId':PROJECT,'query':q,'querySha256':sha(q.encode())},'FIXED_QUERY')
    derived=preflight();require(s['expectedRow']==derived['expectedRow'] and s['control']==derived['control'] and decode(raw)==derived['binding'],'FIXED_FULL_DERIVED_BINDING')
    active=decode(checked(BASE/'active-round.json',0o600));expected_active={'schemaVersion':1,'roundId':ROUND_ID,'configSha256':selector(),'seedSha256':sha(encoded(seed))}
    if historical_diagnostic and active!=expected_active:
        # Append-only late raw is allowed on an ancestor allocated by THIS root.
        # Follow fixed allocator pointers only; this never restores any permit.
        visited=set()
        while active!=expected_active:
            require(exact(active,['schemaVersion','roundId','configSha256','seedSha256']) and active['schemaVersion']==1 and active['configSha256']==selector() and type(active['roundId']) is str and RID.fullmatch(active['roundId']) and type(active['seedSha256']) is str and SHA.fullmatch(active['seedSha256']) and active['roundId'] not in visited,'FIXED_HISTORICAL_ROUND_LINEAGE')
            visited.add(active['roundId']);rr=ROUNDS/active['roundId'];st=rr.lstat()
            require(stat.S_ISDIR(st.st_mode) and not stat.S_ISLNK(st.st_mode) and st.st_uid==os.getuid() and stat.S_IMODE(st.st_mode)==0o700,'FIXED_HISTORICAL_ROUND_DIRECTORY')
            require(sha(checked(rr/'connector-host-task/fixed-seed.json',0o600))==active['seedSha256'],'FIXED_HISTORICAL_SEED')
            active=decode(checked(rr/'previous-active-round.json',0o600))
    require(active==expected_active,'FIXED_ACTIVE_ROUND')
    return s

def helper(op,payload=None,s=None):
    s=s or state();r=subprocess.run([str(NODE),'--require',str(HOST/'connector-host-no-network.cjs'),'--import',str(PACKAGE/'node_modules/tsx/dist/loader.mjs'),str(CANDIDATE/'fixed-recovery-helper.mts'),op,ROUND_ID],cwd=VENDOR,env=node_env(s['bindingSha256']),input=encoded(payload) if payload is not None else b'',capture_output=True)
    require(r.returncode==0,'FIXED_DATA_CHECK:'+r.stderr.decode(errors='replace')[-1800:]);return decode(r.stdout)

def root_lock(name='allocation.lock'):
    require(name in ('allocation.lock','execution.lock'),'FIXED_LOCK_NAME')
    directories(BASE/name);fd=os.open(BASE/name,os.O_RDWR|os.O_CREAT|os.O_NOFOLLOW,0o600);st=os.fstat(fd)
    require(stat.S_ISREG(st.st_mode) and st.st_uid==os.getuid() and st.st_nlink==1 and stat.S_IMODE(st.st_mode)==0o600,'FIXED_ALLOCATION_LOCK')
    try:fcntl.flock(fd,fcntl.LOCK_EX|fcntl.LOCK_NB)
    except Exception:os.close(fd);raise RuntimeError('FIXED_ORIGINAL_WRAPPER_OR_ALLOCATOR_STILL_ACTIVE')
    return fd

def allocate(derived,previous_active=None):
    execution_fd=root_lock('execution.lock')
    try:return allocate_stopped(derived,previous_active)
    finally:os.close(execution_fd)

def allocate_stopped(derived,previous_active=None):
    c=config();round_id='round-'+uuid.uuid4().hex;root=ROUNDS/round_id;root.mkdir(mode=0o700)
    private=root/'connector-host-task';private.mkdir(mode=0o700)
    for p in (private/'relay',private/'artifacts'):p.mkdir(mode=0o700)
    select_round(round_id)
    binding_bytes=encoded(derived['binding']);binding_sha=sha(binding_bytes);binding_file=BINDINGS/(binding_sha+'.json')
    if binding_file.exists():require(checked(binding_file,0o400)==binding_bytes,'FIXED_BINDING_CHANGED')
    else:put(binding_file,binding_bytes,0o400)
    seed={'projectId':PROJECT,'candidateId':c['candidate']['id'],'sourceId':SOURCE_ID,'batchId':batch_id(round_id),'buildSha256':c['build']['contentSha256'],'launchChallenge':os.urandom(32).hex()}
    cfg={'repo':str(VENDOR),'root':str(HOST),'project':PROJECT,'sourceId':SOURCE_ID,'mode':'NATIVE_PORTABLE_CONNECTOR_V1','bindingSha256':binding_sha,'roundId':round_id,'taskRoot':str(private),'relayDirectory':str(private/'relay')}
    q=query(c['candidate']['id']);qualification={'configSha256':selector(),'packageManifestSha256':c['packageManifestSha256'],'build':c['build'],'candidate':c['candidate'],'expectedRowSha256':sha(canonical(c['expectedRow']).encode()),'kind':c['kind']}
    s={'kind':'FIXED_PREFLIGHT','mode':mode(),'roundId':round_id,'seed':seed,'cfg':cfg,'bootstrap':{'projectId':PROJECT,'query':q,'querySha256':sha(q.encode())},'qualification':qualification,'expectedRow':derived['expectedRow'],'control':derived['control'],'bindingSha256':binding_sha,'preparedAt':datetime.datetime.now(UTC).isoformat(),'configSha256':selector()}
    put(private/'fixed-seed.json',seed);put(private/'prepared.json',s)
    if mode()=='TEST_ONLY':put(private/'test-only-context.json',derived['fixtureContext'])
    active={'schemaVersion':1,'roundId':round_id,'configSha256':selector(),'seedSha256':sha(encoded(seed))}
    if previous_active is None:put(BASE/'active-round.json',active)
    else:
        require(checked(BASE/'active-round.json',0o600)==previous_active,'FIXED_ACTIVE_CAS')
        # Preserve the old pointer before a same-root atomic replacement. No old
        # task, intent, request, response or evidence is deleted or rewritten.
        put(root/'previous-active-round.json',previous_active)
        temp=root/'next-active-round.json';put(temp,active);os.replace(temp,BASE/'active-round.json')
    r=subprocess.run(['/usr/bin/python3','-I',str(HOST/'connector-host-launch.py'),'host-files.mts','connector-validate'],cwd=VENDOR,env=node_env(binding_sha),capture_output=True)
    require(r.returncode==0,'FIXED_ORIGINAL_BINDING:'+r.stderr.decode(errors='replace')[-1800:]);v=decode(r.stdout);require(v['taskRoot']==str(private) and v['relayDirectory']==str(private/'relay') and v['candidateId']==seed['candidateId'] and v['buildContentSha256']==seed['buildSha256'],'FIXED_ORIGINAL_BINDING_IDENTITY')
    return public_prepared(s)

def relay_publication_state():
    # Independent marker enumeration: a missing or changed request never erases
    # evidence that publication may have been sent. Validate selectors BEFORE I/O.
    requests={}
    for f in (PRIVATE/'relay').glob('*.request.json'):
        rid=f.name[:-len('.request.json')]
        require(UUID.fullmatch(rid),'FIXED_REQUEST_FILENAME')
        r=decode(checked(f,0o600))
        require(exact(r,['schemaVersion','requestId','kind','expiresAt','payload','requestSha256']) and r['schemaVersion']==1 and type(r['requestId']) is str and UUID.fullmatch(r['requestId']) and r['requestId']==rid and r['kind'] in ('READ_CONTEXT','READ_PUBLICATION_CONTEXT','PUBLISH','READ_OUTCOME') and type(r['requestSha256']) is str and SHA.fullmatch(r['requestSha256']),'FIXED_REQUEST_IDENTITY')
        require(sha(encoded({k:v for k,v in r.items() if k!='requestSha256'}))==r['requestSha256'],'FIXED_REQUEST_HASH')
        requests[rid]=r
    marked=[];not_dispatched=[]
    for f in (PRIVATE/'relay').glob('*.dispatch.json'):
        rid=f.name[:-len('.dispatch.json')]
        require(UUID.fullmatch(rid),'FIXED_MARKER_FILENAME')
        m=decode(checked(f,0o600))
        require(exact(m,['schemaVersion','requestId','requestSha256','kind','state','markedAt']) and m.get('schemaVersion')==1 and type(m.get('requestId')) is str and UUID.fullmatch(m['requestId']) and m['requestId']==rid and m.get('state') in ('MAY_HAVE_BEEN_SENT','NOT_DISPATCHED'),'FIXED_MARKER_IDENTITY')
        require(rid in requests,'FIXED_ORPHAN_DISPATCH_HOLD')
        r=requests[rid]
        require(m.get('kind')==r['kind'] and m.get('requestSha256')==r['requestSha256'],'FIXED_CONTRADICTORY_DISPATCH_HOLD')
        if m['state']=='NOT_DISPATCHED':
            # Exact original expire-undispatched terminal, never a fabricated ack.
            expiry=utc_timestamp(r['expiresAt']);marked_at=utc_timestamp(m['markedAt'])
            require(marked_at>=expiry and datetime.datetime.now(UTC)>=marked_at,'FIXED_NOT_DISPATCHED_EXPIRY')
            response_file=PRIVATE/'relay'/(rid+'.response.json');response_bytes=checked(response_file,0o600);response=decode(response_bytes)
            expected={'schemaVersion':1,'requestId':rid,'requestSha256':r['requestSha256'],'kind':r['kind'],'result':{'status':'FAILED','outcome':'NOT_DISPATCHED','code':'REQUEST_EXPIRED'}}
            require(response==expected,'FIXED_NOT_DISPATCHED_RESPONSE')
            if r['kind']=='PUBLISH':
                require(not (PRIVATE/('tool-result-'+rid+'.json')).exists() and not (PRIVATE/('tool-result-'+rid+'.fact.json')).exists(),'FIXED_NOT_DISPATCHED_TOOL_CONTRADICTION')
                not_dispatched.append({'request':r,'markerSha256':sha(checked(f,0o600)),'responseSha256':sha(response_bytes)})
        elif m['kind']=='PUBLISH':
            response_file=PRIVATE/'relay'/(rid+'.response.json')
            if response_file.exists():
                response=decode(checked(response_file,0o600))
                require(type(response) is dict and not (type(response.get('result')) is dict and response['result'].get('outcome')=='NOT_DISPATCHED'),'FIXED_MAY_SENT_NOT_DISPATCHED_CONTRADICTION')
            marked.append(r)
    return [r for r in requests.values() if r['kind']=='PUBLISH'],marked,not_dispatched

def prepare():
    derived=preflight();fd=root_lock()
    try:
        for p in (ROUNDS,BINDINGS):
            if not p.exists():p.mkdir(mode=0o700)
            directories(p/'scope-check')
        active=BASE/'active-round.json'
        if active.exists():
            a=decode(checked(active,0o600));require(exact(a,['schemaVersion','roundId','configSha256','seedSha256']) and a['schemaVersion']==1 and a['configSha256']==selector(),'FIXED_ACTIVE_SCOPE');select_round(a['roundId']);s=state()
            if not (PRIVATE/'launch-intent.json').exists():return {'kind':'ROUND_INCOMPLETE','roundId':ROUND_ID,'publishMayHaveBeenSent':False,'reason':'EXISTING_UNLAUNCHED_ROUND_NOT_REPLACED'}
            publications,marked,not_dispatched=relay_publication_state()
            if not_dispatched:
                require(not marked,'FIXED_NOT_DISPATCHED_MIXED_UNKNOWN')
                data=known_not_dispatched_data(s,publications,marked,not_dispatched)
                terminal_path=PRIVATE/'known-not-dispatched-terminal.json'
                if terminal_path.exists():
                    terminal=decode(checked(terminal_path,0o600));validate_known_terminal(terminal,s,data)
                    return allocate(derived,checked(active,0o600))
                return {'kind':'KNOWN_NOT_DISPATCHED_TERMINAL_REQUIRED','roundId':ROUND_ID,'seed':s['seed'],'classification':data,'newRoundCreated':False,'oldPublicationCalls':0,'reason':'ORIGINAL_LIVE_CHILD_AND_TOOL_TERMINAL_REQUIRED'}
            if not marked:
                # A no-publication terminal receipt never clears a PUBLISH marker.
                if (PRIVATE/'no-publication-terminal.json').exists():
                    terminal=decode(checked(PRIVATE/'no-publication-terminal.json',0o600));require(exact(terminal,['schemaVersion','roundId','seed','originalSessionId','wrapperExitCode','childExitCode','childSignal','pipeHeld','outcomeConsumed','noPublishDispatch']) and terminal['schemaVersion']==1 and terminal['seed']==s['seed'] and terminal['roundId']==ROUND_ID and terminal['noPublishDispatch'] is True and terminal['wrapperExitCode']==0 and terminal['childExitCode']==0 and terminal['childSignal'] is None and terminal['pipeHeld'] is False and terminal['outcomeConsumed'] is False and not publications,'FIXED_NO_PUBLICATION_RECEIPT')
                    return allocate(derived,checked(active,0o600))
                return {'kind':'ROUND_INCOMPLETE','roundId':ROUND_ID,'publishMayHaveBeenSent':False,'reason':'ORIGINAL_PRE_PUBLICATION_SESSION_MUST_TERMINATE'}
            require(len(publications)==1 and len(marked)==1,'FIXED_PUBLISH_SET')
            recovery=helper('recovery-query',s=s)
            return {'kind':'RECOVERY_REQUIRED','mode':mode(),'roundId':ROUND_ID,'seed':s['seed'],'cfg':s['cfg'],**recovery}
        # A removed pointer cannot turn an existing deployment into a new start.
        require(not list(ROUNDS.iterdir()),'FIXED_ORPHAN_ROUNDS_REQUIRE_REVIEW')
        return allocate(derived)
    finally:os.close(fd)
def utc_timestamp(value):
    require(type(value) is str and re.fullmatch(r'\d{4}-\d\d-\d\dT\d\d:\d\d:\d\d(?:\.\d{1,6})?(?:Z|\+00:00)',value),'FIXED_CHECKED_AT_UTC')
    d=datetime.datetime.fromisoformat(value.replace('Z','+00:00'));require(d.utcoffset()==datetime.timedelta(0),'FIXED_CHECKED_AT_UTC');return d

def age(value,maximum):require(0<=(datetime.datetime.now(UTC)-utc_timestamp(value)).total_seconds()<maximum,'FIXED_BOOTSTRAP_AGE')
def tool_rows(raw):
    require(type(raw) is dict and raw.get('isError') is not True,'FIXED_OFFICIAL_ERROR');candidates=[]
    if type(raw.get('structuredContent')) is dict and 'result' in raw['structuredContent']:candidates.append(raw['structuredContent']['result'])
    for item in raw.get('content',[]):
        if type(item) is dict and item.get('type')=='text':
            obj=decode(item['text'].encode());require(type(obj) is dict and 'result' in obj,'FIXED_OFFICIAL_TEXT');candidates.append(obj['result'])
    require(candidates and all(type(x) is str and x==candidates[0] for x in candidates),'FIXED_OFFICIAL_RESULT')
    matches=list(re.finditer(r'^<untrusted-data-([^>\r\n]+)>\n(.*?)\n</untrusted-data-\1>',candidates[0],re.M|re.S));require(len(matches)==1,'FIXED_ORIGINAL_DATA_BOUNDARY')
    rows=decode(matches[0].group(2).encode());require(type(rows) is list,'FIXED_OFFICIAL_ROWS');return rows

def expected_bootstrap(raw,s):
    rows=tool_rows(decode(raw));require(len(rows)==1 and exact(rows[0],['checkedAt','candidate']),'FIXED_BOOTSTRAP_ROW_COUNT')
    row=rows[0]['candidate'];expected=s['expectedRow'];require(type(row) is dict and all(k in row and type(row[k]) is type(v) and row[k]==v for k,v in expected.items()),'FIXED_16_FIELD_BINDING')
    utc_timestamp(rows[0]['checkedAt'])
    return {'schemaVersion':1,'checkedAt':utc_timestamp(rows[0]['checkedAt']).isoformat().replace('+00:00','Z'),'candidateRows':[row],'batchId':s['seed']['batchId']}

def raw_checked_at(raw):return tool_rows(decode(raw))[0]['checkedAt']

def stdin_bytes(limit=20*1024*1024):
    b=sys.stdin.buffer.read(limit+1);require(0<len(b)<=limit,'FIXED_STDIN_SIZE');return b

def accept_bootstrap():
    s=state();require(not (PRIVATE/'launch-intent.json').exists(),'FIXED_ALREADY_LAUNCHED')
    raw=stdin_bytes(16*1024*1024);put(PRIVATE/'bootstrap-official-raw.json',raw)
    bootstrap=expected_bootstrap(raw,s);checked_at=raw_checked_at(raw);age(checked_at,50)
    receipt=put(PRIVATE/'bootstrap-producer.json',bootstrap);put(PRIVATE/'control.json',s['control'])
    accepted={'kind':'FIXED_BOOTSTRAP_ACCEPTED','roundId':ROUND_ID,'requestSha256':s['bootstrap']['querySha256'],'rawSha256':sha(raw),'seed':s['seed'],'cfg':s['cfg'],'bootstrapSha256':receipt['sha256'],'checkedAt':checked_at}
    put(PRIVATE/'bootstrap-accepted.json',accepted);return accepted

def check_launch_data(s,e):
    require(exact(e,['schemaVersion','roundId','seed','cfg','bindingSha256','querySha256','rawSha256','bootstrapSha256','checkedAt']) and e['schemaVersion']==1 and e['roundId']==ROUND_ID and e['seed']==s['seed'] and e['cfg']==s['cfg'] and e['bindingSha256']==s['bindingSha256'] and e['querySha256']==s['bootstrap']['querySha256'] and all(type(e[k]) is str and SHA.fullmatch(e[k]) for k in ('rawSha256','bootstrapSha256')),'FIXED_LAUNCH_EXPECTATION')
    # These hashes come from the functions closure's actual official tool result,
    # not a self-reported task file. The caller has already consumed its private
    # one-use launch permit; this JSON only restricts the fixed local operation.
    raw=checked(PRIVATE/'bootstrap-official-raw.json',0o600);require(sha(raw)==e['rawSha256'],'FIXED_CAPTURED_RAW_HASH')
    expected=expected_bootstrap(raw,s);bootstrap=checked(PRIVATE/'bootstrap-producer.json',0o600)
    require(bootstrap==encoded(expected) and sha(bootstrap)==e['bootstrapSha256'] and raw_checked_at(raw)==e['checkedAt'],'FIXED_RAW_BOOTSTRAP_EXACT')
    accepted=decode(checked(PRIVATE/'bootstrap-accepted.json',0o600))
    require(accepted=={'kind':'FIXED_BOOTSTRAP_ACCEPTED','roundId':ROUND_ID,'requestSha256':e['querySha256'],'rawSha256':e['rawSha256'],'seed':s['seed'],'cfg':s['cfg'],'bootstrapSha256':e['bootstrapSha256'],'checkedAt':e['checkedAt']},'FIXED_ACCEPTED_EXACT')
    require(decode(checked(PRIVATE/'control.json',0o600))==s['control'],'FIXED_CONTROL_EXACT');age(e['checkedAt'],60)
    return bootstrap

def redirect_wrapper_stderr():
    # Keep Node startup diagnostics out of the strict framed stdout channel.
    # The original wrapper creates its own diagnostics directory later; this
    # fixed sibling file also captures warnings emitted before its module runs.
    target=PRIVATE/'wrapper-stderr.log';before=directories(target)
    fd=os.open(target,os.O_WRONLY|os.O_CREAT|os.O_EXCL|os.O_NOFOLLOW,0o600)
    try:
        st=os.fstat(fd)
        require(stat.S_ISREG(st.st_mode) and st.st_uid==os.getuid() and st.st_nlink==1 and stat.S_IMODE(st.st_mode)==0o600,'FIXED_WRAPPER_STDERR_FILE')
        require(identity(st)==identity(target.lstat()) and before==directories(target),'FIXED_WRAPPER_STDERR_CHANGED')
        if fd==2:os.set_inheritable(2,True)
        else:os.dup2(fd,2,inheritable=True)
    finally:
        if fd!=2:os.close(fd)

def launch():
    expectation=decode(stdin_bytes());s=state();check_launch_data(s,expectation)
    require(not list((PRIVATE/'relay').iterdir()) and not list((PRIVATE/'artifacts').iterdir()),'FIXED_TASK_NOT_EMPTY')
    require(not (PRIVATE/'diagnostics').exists(),'FIXED_DIAGNOSTICS_EXISTS')
    preflight('check')
    # Last re-read AFTER preflight. Never refresh the DB timestamp or replace raw.
    bootstrap=check_launch_data(s,expectation)
    allocation_fd=root_lock();execution_fd=root_lock('execution.lock')
    # Recheck the active round under the allocator lock. Keep the independent
    # execution flock across exec until the real wrapper process terminates.
    active=decode(checked(BASE/'active-round.json',0o600));require(active=={'schemaVersion':1,'roundId':ROUND_ID,'configSha256':selector(),'seedSha256':sha(encoded(s['seed']))},'FIXED_LAUNCH_ACTIVE_CAS')
    check_launch_data(s,expectation)
    os.set_inheritable(execution_fd,True)
    put(PRIVATE/'launch-intent.json',{'schemaVersion':1,'roundId':ROUND_ID,'seed':s['seed'],'expectation':expectation,'scope':'One original wrapper; unknown publication must not be replayed.'})
    env=node_env(s['bindingSha256']);env.update(approved_producer_environment(os.environ));env.update({'JOBFINDER_OWNED_PIPE_MODE':mode(),'JOBFINDER_FIXED_PROJECTION_MODE':mode()})
    child=[str(NODE)]
    if mode()=='TEST_ONLY':child+=['--require',str(PACKAGE/'test/no-network.cjs'),'--require',str(CANDIDATE/'fixed-source-fixture.cjs')]
    child+=['--import',str(PACKAGE/'node_modules/tsx/dist/loader.mjs'),str(VENDOR/'scripts/p0-cloud-portable-source-pilot.ts'),str(PRIVATE/'bootstrap-producer.json'),sha(bootstrap),str(PRIVATE/'artifacts'),str(PRIVATE/'relay'),'--db-started-control',str(PRIVATE/'control.json')]
    argv=[str(NODE),str(PACKAGE/'connector-gate/run-with-owned-publication-pipe.mjs'),encoded(s['seed']).decode(),str(PRIVATE/'diagnostics'),'1800000','--',*child]
    os.close(allocation_fd)
    redirect_wrapper_stderr()
    os.chdir(VENDOR);os.execve(NODE,argv,env)

KNOWN_TERMINAL_KEYS=['schemaVersion','roundId','seed','originalSessionId','wrapperExitCode','childExitCode','childSignal','pipeHeld','terminalIntegrity','outcomeConsumed','publicationInvoked','publicationPromisePresent','requestId','requestSha256','markerSha256','responseSha256','recoveryDataSha256']
def known_not_dispatched_data(s,publications,marked,not_dispatched):
    require(not marked and len(publications)==1 and len(not_dispatched)==1 and not_dispatched[0]['request']==publications[0],'FIXED_NOT_DISPATCHED_PUBLICATION_SET')
    fact=not_dispatched[0];r=publications[0];packet=helper('publication-data',s=s)
    require(packet['requestId']==r['requestId'] and packet['requestSha256']==r['requestSha256'] and packet['originalPublishExpiresAt']==r['expiresAt'],'FIXED_NOT_DISPATCHED_ORIGINAL_PACKET')
    return {'publicationState':'KNOWN_NOT_DISPATCHED','requestId':r['requestId'],'requestSha256':r['requestSha256'],'originalPublishExpiresAt':r['expiresAt'],'markerSha256':fact['markerSha256'],'responseSha256':fact['responseSha256'],'recoveryDataSha256':packet['recoveryDataSha256']}
def validate_known_terminal(x,s,data):
    require(exact(x,KNOWN_TERMINAL_KEYS) and x['schemaVersion']==1 and x['roundId']==ROUND_ID and x['seed']==s['seed'] and type(x['originalSessionId']) is int and x['originalSessionId']>0 and type(x['wrapperExitCode']) is int and x['wrapperExitCode']>=0 and type(x['childExitCode']) is int and x['childExitCode']>=0 and x['childSignal'] is None and x['wrapperExitCode']==x['childExitCode'] and type(x['pipeHeld']) is bool and x['pipeHeld']==(x['childExitCode']!=0) and x['terminalIntegrity']=='EXACT_NATURAL_TERMINAL' and x['outcomeConsumed'] is False and x['publicationInvoked'] is False and x['publicationPromisePresent'] is False,'FIXED_KNOWN_NOT_DISPATCHED_TERMINAL')
    for key in ['requestId','requestSha256','markerSha256','responseSha256','recoveryDataSha256']:require(x[key]==data[key],'FIXED_KNOWN_NOT_DISPATCHED_TERMINAL_BINDING')
def read_dispatch_state():
    s=state();publications,marked,not_dispatched=relay_publication_state()
    if marked:
        require(not not_dispatched,'FIXED_NOT_DISPATCHED_MIXED_UNKNOWN')
        data={'publicationState':'MAY_HAVE_BEEN_SENT'}
    elif not_dispatched:data=known_not_dispatched_data(s,publications,marked,not_dispatched)
    else:data={'publicationState':'NO_PUBLISH_DISPATCH_EVIDENCE'}
    return {'kind':'FIXED_DISPATCH_CLASSIFICATION','roundId':ROUND_ID,'seed':s['seed'],**data,'newRoundAllowed':False,'grantsAuthority':False}
def close_known_not_dispatched():
    x=decode(stdin_bytes());s=state();require((PRIVATE/'launch-intent.json').exists(),'FIXED_NO_LAUNCH')
    # Only the fixed live functions consumer calls this operation after its
    # ORIGINAL child/tool terminal, with no official publication call/Promise.
    # Input JSON restricts that close; it never recreates terminal authority.
    fd=root_lock();execution_fd=None
    try:
        execution_fd=root_lock('execution.lock')
        publications,marked,not_dispatched=relay_publication_state();data=known_not_dispatched_data(s,publications,marked,not_dispatched);validate_known_terminal(x,s,data)
        active=decode(checked(BASE/'active-round.json',0o600));require(active['roundId']==ROUND_ID and active['seedSha256']==sha(encoded(s['seed'])),'FIXED_ACTIVE_CAS')
        receipt=put(PRIVATE/'known-not-dispatched-terminal.json',x)
        return {'kind':'FIXED_KNOWN_NOT_DISPATCHED_CLOSED','roundId':ROUND_ID,'seed':s['seed'],'requestId':data['requestId'],'requestSha256':data['requestSha256'],'terminalReceiptSha256':receipt['sha256'],'oldPublicationCalls':0,'newSuccessRecorded':False,'oldFailurePreserved':True,'oldPermitRestored':False}
    finally:
        if execution_fd is not None:os.close(execution_fd)
        os.close(fd)

def read_projections():
    s=state();require((PRIVATE/'launch-intent.json').exists(),'FIXED_NO_LAUNCH');return helper('projections',s=s)
def read_publication_data():
    s=state();require((PRIVATE/'launch-intent.json').exists(),'FIXED_NO_LAUNCH');return helper('publication-data',s=s)
def record_dispatch_data():
    x=decode(stdin_bytes());s=state();require(exact(x,['schemaVersion','roundId','seed','requestId','requestSha256','sqlSha256','recoveryDataSha256']) and x['schemaVersion']==1 and x['roundId']==ROUND_ID and x['seed']==s['seed'],'FIXED_DISPATCH_DATA_INPUT')
    data=helper('publication-data',s=s)
    for k in ('requestId','requestSha256','sqlSha256','recoveryDataSha256'):require(x[k]==data[k],'FIXED_DISPATCH_DATA_BINDING')
    require(not (PRIVATE/'relay'/(x['requestId']+'.dispatch.json')).exists(),'FIXED_DISPATCH_ALREADY_OR_UNKNOWN')
    put(PRIVATE/'dispatch-data.json',x)
    return {'kind':'FIXED_DISPATCH_DATA_RECORDED','roundId':ROUND_ID,**{k:x[k] for k in ('requestId','requestSha256','sqlSha256','recoveryDataSha256')},'grantsAuthority':False}

def classify_context():
    raw=stdin_bytes();x=decode(raw);s=state()
    require(exact(x,['schemaVersion','requestId','requestSha256','responseSha256','captureStartedAtMs']) and x['schemaVersion']==1 and type(x['requestId']) is str and UUID.fullmatch(x['requestId']) and all(type(x[k]) is str and SHA.fullmatch(x[k]) for k in ('requestSha256','responseSha256')) and type(x['captureStartedAtMs']) is int,'FIXED_CONTEXT_EXPECTATION')
    data=helper('classify-context',x,s=s);return {'kind':'FIXED_CAPTURE_ADMISSION','inputSha256':sha(raw),**data}

def accept_reconciliation():
    x=decode(stdin_bytes());s=state();require(exact(x,['schemaVersion','roundId','querySha256','rawSha256','rawBytes','requestId','requestSha256','recoveryDataSha256']) and x['schemaVersion']==1 and x['roundId']==ROUND_ID and type(x['rawBytes']) is str and len(x['rawBytes'].encode())<=16*1024*1024 and sha(x['rawBytes'].encode())==x['rawSha256'],'FIXED_RECONCILIATION_EXPECTATION')
    original=helper('recovery-query',s=s)
    for k in ('querySha256','requestId','requestSha256','recoveryDataSha256'):require(x[k]==original[k],'FIXED_RECONCILIATION_BINDING')
    # Every recovery read has its own diagnostic bytes, never an old relay
    # response. Missing/conflicting rows preserve UNKNOWN and retain all intents.
    read_id=uuid.uuid4().hex;raw=x['rawBytes'].encode();put(PRIVATE/('reconciliation-'+read_id+'.raw.json'),raw)
    result=helper('verify-recovery',{'rows':tool_rows(decode(raw))},s=s)
    receipt={'schemaVersion':1,'roundId':ROUND_ID,'requestId':x['requestId'],'requestSha256':x['requestSha256'],'querySha256':x['querySha256'],'rawSha256':x['rawSha256'],'recoveryDataSha256':x['recoveryDataSha256'],'databaseStatus':result['databaseStatus'],'ui':'UNVERIFIED','oldLaunchPermitRestored':False,'oldPublicationPermitRestored':False,'oldIpcRestored':False,'actualObservationCrawledAtRead':False,'originalPublishExpiresAt':original['originalPublishExpiresAt']}
    put(PRIVATE/('reconciliation-'+read_id+'.receipt.json'),receipt)
    if result['databaseStatus']!='DB_RECONCILED_COMMITTED':return {'kind':'RECOVERY_HOLD','roundId':ROUND_ID,'previous':receipt,'newRoundCreated':False,'publicationCalls':0}
    # Original cloudDbStartedPilot UNKNOWN recovery waits packet.expiresAt.
    # Reuse that immutable request deadline, never a new wait or 1800s gate.
    if datetime.datetime.now(UTC)<utc_timestamp(original['originalPublishExpiresAt']):return {'kind':'RECOVERY_COMMITTED_HELD_UNTIL_ORIGINAL_DEADLINE','roundId':ROUND_ID,'previous':receipt,'newRoundCreated':False,'oldPublicationCalls':0}
    old_round=ROUND_ID;fd=root_lock()
    try:
        old_active=checked(BASE/'active-round.json',0o600);require(decode(old_active)['roundId']==old_round,'FIXED_ACTIVE_CAS')
        next_round=allocate(preflight(),old_active)
        return {'kind':'RECOVERY_COMMITTED_NEXT_PREFLIGHT','previous':receipt,'next':next_round,'oldPublicationCalls':0}
    finally:os.close(fd)

def close_no_publication():
    x=decode(stdin_bytes());s=state()
    require(exact(x,['schemaVersion','roundId','seed','originalSessionId','wrapperExitCode','childExitCode','childSignal','pipeHeld','outcomeConsumed','noPublishDispatch']) and x['schemaVersion']==1 and x['roundId']==ROUND_ID and x['seed']==s['seed'] and type(x['originalSessionId']) is int and x['originalSessionId']>0 and type(x['wrapperExitCode']) is int and x['wrapperExitCode']==0 and type(x['childExitCode']) is int and x['childExitCode']==0 and x['childSignal'] is None and x['pipeHeld'] is False and x['outcomeConsumed'] is False and x['noPublishDispatch'] is True,'FIXED_NO_PUBLICATION_TERMINAL')
    # The fixed functions body calls only from the original live consumer's
    # actual tool and child terminal. This cannot clear any publication intent.
    publications,marked,not_dispatched=relay_publication_state();require(not publications and not marked,'FIXED_UNKNOWN_PUBLICATION_CANNOT_CLOSE')
    put(PRIVATE/'no-publication-terminal.json',x)
    return {'kind':'FIXED_NO_PUBLICATION_CLOSED','roundId':ROUND_ID,'seed':s['seed'],'newSuccessRecorded':False,'publicationMayHaveBeenSent':False}

def read_test_oracle():
    require(mode()=='TEST_ONLY','FIXED_LIVE_ORACLE_FORBIDDEN');s=state();context=decode(checked(PRIVATE/'test-only-context.json',0o600))
    out={'kind':'TEST_ONLY_DATA_ORACLE','seed':s['seed'],'cfg':s['cfg'],'bootstrap':s['bootstrap'],'expectedRow':s['expectedRow'],'context':context,'model':None,'productionQualified':False}
    p=PRIVATE/'test-only-reviewed-packet.json'
    if p.exists():model=decode(checked(p,0o600));model['projections']=decode(checked(PRIVATE/'reviewed-projections.json',0o600))['projections'];out['model']=model
    return out

def record_tool_result():
    s=state(historical_diagnostic=True);require((PRIVATE/'launch-intent.json').exists(),'FIXED_NO_LAUNCH');x=decode(stdin_bytes())
    require(exact(x,['requestId','requestSha256','kind','rawBytes','rawSha256','settlementType','observedAt']) and x['settlementType'] in ('FULFILLED','REJECTED','THREW') and type(x['observedAt']) is int and 0<x['observedAt']<=int(datetime.datetime.now(UTC).timestamp()*1000) and type(x['rawBytes']) is str and len(x['rawBytes'].encode())<=16*1024*1024 and type(x['requestId']) is str and UUID.fullmatch(x['requestId']) and x['kind'] in ('READ_CONTEXT','READ_PUBLICATION_CONTEXT','READ_OUTCOME','PUBLISH') and SHA.fullmatch(x['requestSha256']) and sha(x['rawBytes'].encode())==x['rawSha256'],'FIXED_DIAGNOSTIC_INPUT')
    r=decode(checked(PRIVATE/'relay'/(x['requestId']+'.request.json'),0o600));require(r['requestId']==x['requestId'] and r['requestSha256']==x['requestSha256'] and r['kind']==x['kind'],'FIXED_DIAGNOSTIC_REQUEST')
    mark=decode(checked(PRIVATE/'relay'/(x['requestId']+'.dispatch.json'),0o600));require(mark['requestId']==x['requestId'] and mark['requestSha256']==x['requestSha256'] and mark['kind']==x['kind'] and mark['state']=='MAY_HAVE_BEEN_SENT','FIXED_DIAGNOSTIC_MARKER')
    receipt=put(PRIVATE/('tool-result-'+x['requestId']+'.json'),x['rawBytes'].encode());put(PRIVATE/('tool-result-'+x['requestId']+'.fact.json'),{k:x[k] for k in ('requestId','requestSha256','kind','rawSha256','settlementType','observedAt')})
    return {'kind':'FIXED_TOOL_RESULT_RECORDED','requestId':x['requestId'],'requestSha256':x['requestSha256'],'rawSha256':receipt['sha256'],'settlementType':x['settlementType'],'bytes':receipt['bytes'],'grantsAuthority':False}

def main():
    operations={'prepare':prepare,'read-dispatch-state':read_dispatch_state,'close-known-not-dispatched':close_known_not_dispatched,'accept-bootstrap':accept_bootstrap,'launch':launch,'read-projections':read_projections,'read-publication-data':read_publication_data,'record-dispatch-data':record_dispatch_data,'classify-context':classify_context,'accept-reconciliation':accept_reconciliation,'close-no-publication':close_no_publication,'read-test-oracle':read_test_oracle,'record-tool-result':record_tool_result}
    require(len(sys.argv)>=2 and sys.argv[1] in operations,'FIXED_OPERATION');op=sys.argv[1]
    require(len(sys.argv)==(2 if op=='prepare' else 3),'FIXED_OPERATION_ARITY')
    if mode()=='DISABLED':return {'kind':'DISABLED_UNQUALIFIED','productionQualified':False,'reason':'EXPLICIT_REVIEWED_DEPLOYMENT_AND_LIVE_ACTIVATION_REQUIRED'}
    require(mode() in ('TEST_ONLY','LIVE'),'FIXED_MODE')
    if op!='prepare':select_round(sys.argv[2])
    return operations[op]()
if __name__=='__main__':
    try:
        result=main()
        if result is not None:print(json.dumps(result,ensure_ascii=False,separators=(',',':')))
    except Exception as error:
        print(json.dumps({'kind':'HOLD','error':str(error),'productionQualified':False}),file=sys.stderr);sys.exit(1)
