/** Pure source/profile tests. Does not attest actual PostgreSQL replay or catalog output. */
import assert from 'node:assert/strict';
import {readFileSync} from 'node:fs';
import {createHash} from 'node:crypto';
import {fileURLToPath} from 'node:url';
import {listCurrentPrismaMigrations,prismaMigrationManifestSha256} from '../vendor/c60-source/src/db/prismaMigrationManifest.ts';
import {V75_FENCE_MIGRATION_NAME,V75_FENCE_MIGRATION_SHA256,V75_FENCE_SCHEMA_SHA256,V75_FENCE_PROSRC_SHA256,compileV75FenceProfileGuard} from '../vendor/c60-source/src/db/v75FenceProfile.ts';
import {JOB_DELTA_MIGRATION_NAME} from '../vendor/c60-source/src/db/jobProjectionDeltaProfile.ts';
import {compileCloudPilotCandidateSql} from '../vendor/c60-source/src/db/cloudPilotSqlControl.ts';
const root=fileURLToPath(new URL('../vendor/c60-source',import.meta.url));
const migrations=listCurrentPrismaMigrations(root);assert.equal(migrations.length,50);
assert.equal(prismaMigrationManifestSha256(migrations),V75_FENCE_SCHEMA_SHA256);
assert.equal(prismaMigrationManifestSha256(migrations.slice(0,-1)),'91ac87fa179ae06c7441141601fd106c5cb636ab739351d5722bed5de151dc3a');
assert.equal(migrations.at(-2)?.migrationName,JOB_DELTA_MIGRATION_NAME);
assert.deepEqual(migrations.at(-1),{migrationName:V75_FENCE_MIGRATION_NAME,checksum:V75_FENCE_MIGRATION_SHA256});
const ddl=readFileSync(root+'/prisma/migrations/'+V75_FENCE_MIGRATION_NAME+'/migration.sql','utf8');
const hash=(s:string)=>createHash('sha256').update(s).digest('hex');
assert.equal(hash(ddl.split('AS $v75_guard$')[1]!.split('$v75_guard$;')[0]!),V75_FENCE_PROSRC_SHA256);
assert(!ddl.includes('UPDATE public."ReleaseCandidate"'));assert(!ddl.includes('INSERT INTO public."_prisma_migrations"'));
assert(ddl.includes('FOR SHARE'));assert(ddl.includes("NEW.\"atomicCommitState\"::text <> 'COMMITTED'"));
const guard=compileV75FenceProfileGuard();
for(const part of ["t.tgenabled='O'","t.tgtype=23","NOT t.tgdeferrable","NOT p.prosecdef","p.proconfig=ARRAY['search_path=pg_catalog, public']",V75_FENCE_PROSRC_SHA256,"PILOT_V75_FENCE_FUNCTION_DRIFT","PILOT_V75_FENCE_TRIGGER_DRIFT"])assert(guard.includes(part),part);
const raw={schemaVersion:2 as const,commitSha:'a'.repeat(40),sourceTreeSha256:'b'.repeat(64),runtimeTreeSha256:'c'.repeat(64)};
const input={projectId:'yiopvxysxrtrnvqxwgbx',build:{...raw,contentSha256:hash(JSON.stringify(raw))},candidate:{id:'schema50-local-fixture',goalId:'jobfinder-portable-required-40',version:76},expiresAt:new Date(Date.now()+60000).toISOString(),databaseIdentity:{migrationVersion:V75_FENCE_MIGRATION_NAME,schemaHash:V75_FENCE_SCHEMA_SHA256,dbSnapshotHash:'e'.repeat(64)}};
const sql=compileCloudPilotCandidateSql(input);
assert(sql.includes(' <> 50'));assert(sql.includes(V75_FENCE_MIGRATION_SHA256));assert(sql.includes(guard));
for(const code of ['PILOT_MIGRATION_HISTORY','PILOT_INCREMENTAL_GUARD_DRIFT','PILOT_INCREMENTAL_TRIGGER_DRIFT','PILOT_INCREMENTAL_FUNCTION_DEFINITION_DRIFT'])assert(sql.includes(code));
assert.throws(()=>compileCloudPilotCandidateSql({...input,databaseIdentity:{...input.databaseIdentity,schemaHash:'0'.repeat(64)}}),/PILOT_SCHEMA50_MANIFEST_DRIFT/);
assert.throws(()=>compileCloudPilotCandidateSql({...input,databaseIdentity:{...input.databaseIdentity,migrationVersion:'unregistered' as never}}));
assert.throws(()=>compileCloudPilotCandidateSql({...input,candidate:{...input.candidate,version:49}}));
console.log(JSON.stringify({kind:'SCHEMA50_STATIC_PROFILE_TESTS',passed:true,migrations:50,postgresExecuted:false,productionQualified:false}));
