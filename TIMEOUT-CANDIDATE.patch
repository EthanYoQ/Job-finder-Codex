+  vi.spyOn(globalThis, "setTimeout").mockImplementation(((callback: (...args: unknown[]) => void, ms?: number, ...args: unknown[]) => {
+    if (ms === 10_000) {
+      delayCalls.push(ms);
+      advance(options.delayMs ?? ms);
+      return realTimeout(callback, 0, ...args);
+    }
+    return realTimeout(callback, ms, ...args);
