+  const calls: Array<{ url: string; at: number; headersSha256: string }> = [];
+  const counts = new Map<string, number>();
+  vi.stubGlobal("fetch", vi.fn(async (input: RequestInfo | URL, init?: RequestInit) => {
+    if (typeof input !== "string") throw Error("Unexpected non-string synthetic request");
+    const url = input;
+    expect(init?.method).toBe("GET");
