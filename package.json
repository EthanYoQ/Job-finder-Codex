{
  "name": "job-search",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vite build",
    "preview": "vite preview --host 127.0.0.1",
    "start": "tsx src/server/httpServer.ts",
    "test": "vitest run --exclude tests/evidence/phase2AggregateManifest.test.ts --exclude tests/evidence/phase3AggregateValidator.test.ts",
    "test:evidence-integration": "tsx scripts/require-external-evidence.ts && vitest run tests/evidence/phase2AggregateManifest.test.ts tests/evidence/phase3AggregateValidator.test.ts",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "prisma:validate": "node ./scripts/prisma-validate.mjs",
    "image:context-check": "node scripts/check-production-image-context.mjs",
    "image:runtime-contract-check": "tsx scripts/check-production-runtime-contract.ts",
    "db:verify-empty-migrations": "tsx scripts/verify-empty-db-migrations.ts",
    "ops:bootstrap": "tsx scripts/ops-bootstrap.ts",
    "p0:crawl": "tsx scripts/p0-crawl.ts",
    "p0:manual-crawl-worker": "tsx scripts/p0-manual-crawl-worker.ts",
    "p0:formal-crawl-once": "tsx scripts/p0-formal-crawl-once.ts",
    "p0:staged-crawl": "tsx scripts/p0-staged-crawl.ts",
    "p0:staged-release-candidate": "tsx scripts/p0-staged-release-candidate.ts",
    "p0:scheduler": "tsx scripts/p0-scheduler.ts",
    "p0:recover-formal-crawl-lock": "tsx scripts/p0-recover-formal-crawl-lock.ts",
    "p0:readiness": "tsx scripts/p0-readiness-report.ts",
    "p0:data-quality": "tsx scripts/p0-data-quality.ts",
    "p0:staged-readiness": "tsx scripts/p0-staged-readiness.ts",
    "p0:staged-data-quality": "tsx scripts/p0-staged-data-quality.ts",
    "p0:staged-release-promotion": "tsx scripts/p0-staged-release-promotion.ts",
    "p0:launch-readiness": "tsx scripts/p0-launch-readiness.ts",
    "browser:smoke": "node scripts/browser-runtime-smoke.mjs",
    "docker:export-provenance": "tsx scripts/export-docker-build-provenance.ts",
    "phase4:manifest": "tsx scripts/generate-phase4-release-manifest.ts",
    "phase4:manifest-candidate": "tsx scripts/generate-phase4-code-candidate-manifest.ts",
    "phase4:scan-candidate": "tsx scripts/scan-phase4-candidate.ts --prestage",
    "phase4:scan-staged": "tsx scripts/scan-phase4-candidate.ts --staged",
    "phase4:audit-evidence": "tsx scripts/audit-phase4-curated-evidence.ts --filesystem",
    "phase4:audit-staged-evidence": "tsx scripts/audit-phase4-curated-evidence.ts --staged",
    "privacy:retention": "tsx scripts/run-privacy-retention.ts",
    "verify:clean-no-outputs": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/verify-clean-no-outputs.ps1"
  },
  "dependencies": {
    "@babel/parser": "^7.29.7",
    "@prisma/client": "^6.19.3",
    "cheerio": "^1.2.0",
    "pg": "8.16.3",
    "playwright-core": "1.61.1",
    "tsx": "^4.20.0",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.6.0",
    "@testing-library/react": "^16.0.0",
    "@testing-library/user-event": "^14.5.0",
    "@tavily/core": "^0.7.6",
    "@types/node": "^22.0.0",
    "@types/pg": "8.15.5",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^4.3.0",
    "jsdom": "^25.0.0",
    "lucide-react": "^0.468.0",
    "prisma": "^6.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "typescript": "^5.8.0",
    "vite": "^6.0.0",
    "vitest": "^3.0.0"
  }
}
