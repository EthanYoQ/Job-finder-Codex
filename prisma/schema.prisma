generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum VerificationStatus {
  UNVERIFIED
  ENTRY_FOUND_PENDING_ADAPTER
  VERIFIED_SCRAPABLE
  TEMP_UNSCRAPABLE
  EXCLUDED
}

enum SourceKind {
  SOCIAL
  CAMPUS
}

enum AtsKind {
  OFFICIAL_HTML
  OFFICIAL_JSON
  MOKA
  BEISEN_ZHIYE
  WORKDAY
  SUCCESSFACTORS
  REDSEA
  BROWSER_FALLBACK
  UNKNOWN
}

enum CrawlStatus {
  SUCCESS
  FAILED
}

enum RequiredJobField {
  COMPANY      @map("company")
  TITLE        @map("title")
  OFFICIAL_URL @map("officialUrl")
  LOCATION     @map("location")
}

enum JobCategory {
  SALES                   @map("销售")
  MARKETING               @map("市场")
  BUSINESS                @map("商务")
  CHANNEL                 @map("渠道")
  KA                      @map("KA")
  MEDICAL_AFFAIRS         @map("医学事务")
  CLINICAL_OPERATIONS     @map("临床运营")
  REGULATORY              @map("注册")
  DRUG_SAFETY             @map("药物警戒/安全")
  RESEARCH_SCIENCE        @map("研发/科学")
  MANUFACTURING_ENGINEERING @map("生产/工程")
  QUALITY                 @map("质量")
  MARKET_ACCESS_GOVERNMENT @map("市场准入/政府事务")
  DATA_IT                 @map("数据/IT")
  SUPPLY_CHAIN_PROCUREMENT @map("供应链/采购")
  CORPORATE_FUNCTIONS     @map("职能")
  OTHER                   @map("其他")
}

enum JobLifecycleStatus {
  ACTIVE
  SUSPECTED_OFFLINE
  OFFLINE
}

enum FeedbackStatus {
  OPEN
  REVIEWED
  CLOSED
  SPAM
}

enum AdminRole {
  ADMIN
}

enum AdminSessionStatus {
  ACTIVE
  REVOKED
  EXPIRED
}

enum ManualCrawlStatus {
  QUEUED
  RUNNING
  SUCCEEDED
  FAILED
}

model Company {
  id                  String              @id @default(cuid())
  officialChineseName  String              @unique
  officialWebsiteUrl   String
  pinyinName          String
  inclusionReason     String
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt
  sources             RecruitmentSource[]
  jobs                Job[]

  @@index([pinyinName])
}

model RecruitmentSource {
  id                       String              @id @default(cuid())
  companyId                String
  kind                     SourceKind
  atsKind                  AtsKind
  officialEntryUrl         String
  officialChainEvidenceUrl String
  campusEntryUrl           String?
  status                   VerificationStatus  @default(UNVERIFIED)
  createdAt                DateTime            @default(now())
  updatedAt                DateTime            @updatedAt
  company                  Company             @relation(fields: [companyId], references: [id], onDelete: Cascade)
  crawlObservations        CrawlObservation[]
  jobs                     Job[]
  manualCrawlRequests      ManualCrawlRequest[]

  @@index([companyId, kind])
  @@index([status])
}

model CrawlBatch {
  id           String             @id @default(cuid())
  startedAt    DateTime           @default(now())
  finishedAt   DateTime?
  status       CrawlStatus
  observations CrawlObservation[]
}

model CrawlObservation {
  id                   String            @id @default(cuid())
  sourceId             String
  batchId              String
  crawledAt            DateTime          @default(now())
  successful           Boolean
  structuredJobCount   Int               @default(0)
  stableRequiredFields  RequiredJobField[]
  failureReason        String?
  source               RecruitmentSource @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  batch                CrawlBatch        @relation(fields: [batchId], references: [id], onDelete: Cascade)

  @@index([sourceId, crawledAt])
  @@index([successful])
}

model Job {
  id                    String             @id @default(cuid())
  companyId             String
  sourceId              String
  dedupeKey             String
  sourceJobId           String?
  officialTitle         String
  auxiliaryChineseTitle String?
  officialUrl           String
  listUrl               String?
  locationRaw           String
  city                  String
  cities                String[]           @default([])
  category              JobCategory
  secondaryCategory     JobCategory?
  classificationConfidence Float?
  classificationRationale  String?
  classificationModelVersion String?
  classificationHardRuleHit String?
  humanCorrectedCategory   JobCategory?
  humanCorrectedSecondaryCategory JobCategory?
  humanCorrectionReason    String?
  humanCorrectedAt         DateTime?
  officialPublishedAt   DateTime?
  firstSeenAt           DateTime           @default(now())
  lastSeenAt            DateTime           @default(now())
  missingSuccessCount   Int                @default(0)
  lifecycleStatus       JobLifecycleStatus @default(ACTIVE)
  visibleInFrontend     Boolean            @default(true)
  isNew                 Boolean            @default(false)
  company               Company            @relation(fields: [companyId], references: [id], onDelete: Cascade)
  source                RecruitmentSource  @relation(fields: [sourceId], references: [id], onDelete: Cascade)

  @@unique([sourceId, dedupeKey])
  @@index([city, category])
  @@index([companyId, lifecycleStatus])
  @@index([visibleInFrontend, lifecycleStatus])
  @@index([firstSeenAt])
}

model Feedback {
  id          String         @id @default(cuid())
  companyId   String?
  jobId       String?
  issueType   String
  description String
  contact     String?
  ip          String
  userAgent   String
  status      FeedbackStatus @default(OPEN)
  createdAt   DateTime       @default(now())

  @@index([status, createdAt])
}

model RecommendedCompany {
  id                  String         @id @default(cuid())
  companyName         String
  officialWebsiteUrl   String?
  recruitmentEntryUrl  String?
  reason              String?
  ip                  String
  userAgent           String
  status              FeedbackStatus @default(OPEN)
  createdAt           DateTime       @default(now())

  @@index([status, createdAt])
}

model AccessEvent {
  id         String   @id @default(cuid())
  ip         String
  userAgent  String
  path       String
  eventType  String
  occurredAt DateTime @default(now())
  metadata   Json?

  @@index([ip, occurredAt])
  @@index([eventType, occurredAt])
}

model AdminUser {
  id           String             @id @default(cuid())
  email        String             @unique
  passwordHash String
  role         AdminRole          @default(ADMIN)
  disabledAt   DateTime?
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt
  sessions     AdminSession[]
  auditEvents  AdminAuditEvent[]
  manualCrawls ManualCrawlRequest[]

  @@index([role])
}

model AdminSession {
  id          String             @id @default(cuid())
  adminUserId String
  tokenHash   String             @unique
  status      AdminSessionStatus @default(ACTIVE)
  ip          String
  userAgent   String
  expiresAt   DateTime
  createdAt   DateTime           @default(now())
  adminUser   AdminUser          @relation(fields: [adminUserId], references: [id], onDelete: Cascade)

  @@index([adminUserId, status])
  @@index([expiresAt])
}

model AdminAuditEvent {
  id          String    @id @default(cuid())
  adminUserId String
  action      String
  targetType  String
  targetId    String?
  ip          String
  userAgent   String
  metadata    Json?
  createdAt   DateTime  @default(now())
  adminUser   AdminUser @relation(fields: [adminUserId], references: [id], onDelete: Cascade)

  @@index([adminUserId, createdAt])
  @@index([action, createdAt])
}

model ManualCrawlRequest {
  id            String            @id @default(cuid())
  sourceId      String
  requestedById String
  status        ManualCrawlStatus @default(QUEUED)
  reason        String?
  createdAt     DateTime          @default(now())
  startedAt     DateTime?
  finishedAt    DateTime?
  failureReason String?
  source        RecruitmentSource @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  requestedBy   AdminUser         @relation(fields: [requestedById], references: [id], onDelete: Restrict)

  @@index([sourceId, status])
  @@index([requestedById, createdAt])
  @@index([status, createdAt])
}
